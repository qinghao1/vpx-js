{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"noEmit": true,
		"strict": true,
		"strictNullChecks": false,
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"useDefineForClassFields": false,
		"allowJs": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.spec.ts"]
}
