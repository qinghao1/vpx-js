{
	"name": "vpx-js",
	"private": true,
	"version": "2.0.0",
	"description": "Visual Pinball for Node.js and the Browser",
	"author": "freezy <freezy@vpdb.io>",
	"contributors": [
		"Jason Millard <jsm174@gmail.com>",
		"Michael Vogt <michael@neeo.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/vpdb/vpx-js"
	},
	"license": "GPL-2.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "npm run build:esm",
		"build:esm": "node build/parallel.mjs -- \"npm run build:esm:tsc\" \"npm run build:esm:cp\"",
		"build:wasm": "wasm/build.sh",
		"build:wasm:headless": "wasm/build-headless.sh",
		"build:wasm:headless:debug": "wasm/build-headless.sh --debug",
		"build:wasm:mock": "wasm/build.sh --mock",
		"typecheck": "tsc --noEmit",
		"typecheck:tests": "tsc --noEmit -p tsconfig.spec.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"dev": "tsc -p tsconfig.json --watch",
		"verify:table": "tsx test/harness/verify-table.ts",
		"verify:browser": "tsx test/harness/verify-browser.ts",
		"verify:play-room": "tsx test/harness/verify-play-room.ts",
		"verify:twd-render": "tsx test/harness/verify-twd-render.ts",
		"verify:ab": "node test/harness/verify-ab.mjs",
		"verify:all": "tsx test/harness/verify-all.ts",
		"verify:e2e": "tsx test/harness/verify-all.ts",
		"prepare": "husky",
		"build:wasm:debug": "wasm/build.sh --debug",
		"bench": "node test/harness/bench.mjs",
		"bench:walking-dead": "node test/harness/bench.mjs --vpx=walking_dead.vpx --profile",
		"bench:walking-dead:browser": "node test/harness/bench.mjs --vpx=walking_dead.vpx --balls=1 --duration=5000 --warmup=1500 --profile",
		"bench:walking-dead:vitest": "vitest bench test/bench/walking-dead.bench.ts --run",
		"build:esm:tsc": "tsc -p tsconfig.json",
		"build:esm:cp": "mkdir -p dist-esm && cp -r res dist-esm/; echo 'dist-esm built'; touch demo-browser/vite.config.ts 2>/dev/null || true",
		"check": "node build/parallel.mjs -- \"npm run lint\" \"npm run typecheck\" \"npm run typecheck:tests\" \"npm run test\"",
		"check:fast": "node build/parallel.mjs -- \"npm run lint\" \"npm run typecheck\" \"npm run typecheck:tests\" \"npm run check:headers\"",
		"check:headers": "node build/check-headers.mjs"
	},
	"dependencies": {
		"pako": "^3.0.3",
		"three": "^0.186.1",
		"three-mesh-bvh": "^0.9.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/chai": "^5.2.3",
		"@types/estree": "^1.0.10",
		"@types/node": "^26.6.6",
		"@types/sinon": "^22.0.2",
		"@types/sinon-chai": "^4.0.1",
		"@types/three": "^0.186.0",
		"@vitest/coverage-v8": "^5.0.5",
		"chai": "^6.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"puppeteer-core": "^25.16.0",
		"sinon": "^22.1.0",
		"sinon-chai": "^4.0.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"bugs": {
		"url": "https://github.com/vpdb/vpx-js/issues"
	},
	"homepage": "https://github.com/vpdb/vpx-js#readme",
	"keywords": [
		"pinball",
		"visual pinball",
		"vp10",
		"vpx"
	],
	"lint-staged": {
		"*.{js,mjs,cjs,ts,jsx,tsx,cts,mts,json,jsonc,css,html}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
