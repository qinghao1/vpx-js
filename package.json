{
	"name": "vpx-js",
	"version": "2.0.0",
	"description": "Visual Pinball for Node.js and the Browser",
	"author": "freezy <freezy@vpdb.io>",
	"contributors": [
		"Jason Millard <jsm174@gmail.com>",
		"Michael Vogt <michael@neeo.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/vpdb/vpx-js"
	},
	"license": "GPL-2.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./lib/refs.node.js": {
			"types": "./dist/lib/refs.node.d.ts",
			"import": "./dist/lib/refs.node.js"
		},
		"./lib/refs.browser.js": {
			"types": "./dist/lib/refs.browser.d.ts",
			"import": "./dist/lib/refs.browser.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**",
		"res/**"
	],
	"bin": {
		"vbs2js": "./dist/bin/vbs2js.js",
		"vpt2glb": "./dist/bin/vpt2glb.js",
		"vptscript": "./dist/bin/vptscript.js"
	},
	"scripts": {
		"build": "npm run build:pre && tsup && npm run build:cp && npm run build:esm",
		"build:pre": "tsx build/compile-rules.ts && tsx build/write-info.ts",
		"build:cp": "cp -r res dist/ && mkdir -p dist/lib/scripting/grammar && cp lib/scripting/grammar/grammar.bnf dist/lib/scripting/grammar/",
		"build:esm": "npm run build:pre && tsc --outDir dist-esm --rootDir . --module ESNext --target ES2024 --moduleResolution bundler --esModuleInterop --allowSyntheticDefaultImports --resolveJsonModule --skipLibCheck --declaration false --declarationMap false --sourceMap true || true; cp -r res dist-esm/; mkdir -p dist-esm/lib/scripting/grammar; cp lib/scripting/grammar/grammar.bnf dist-esm/lib/scripting/grammar/ 2>/dev/null; echo 'dist-esm built'; touch demo-browser/vite.config.ts 2>/dev/null || true",
		"build:wasm": "wasm/build.sh",
		"build:wasm:mock": "wasm/build.sh --mock",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"dev": "tsup --watch",
		"verify:pinmame": "tsx test/harness/verify-pinmame.ts",
		"verify:wasm": "tsx test/harness/verify-wasm.ts",
		"verify": "npm run verify:wasm && npm run verify:table && npm run verify:pinmame && npm run verify:player",
		"verify:table": "tsx test/harness/verify-table.ts",
		"verify:player": "tsx test/harness/verify-player.ts",
		"verify:browser": "tsx test/harness/verify-browser.ts",
		"verify:all": "tsx test/harness/verify-all.ts",
		"verify:e2e": "tsx test/harness/verify-all.ts",
		"prepare": "husky",
		"build:wasm:debug": "wasm/build.sh --debug",
		"test:integration": "vitest run lib/emu/pinmame/pinmame.integration.spec.ts lib/emu/wasm-build.integration.spec.ts lib/scripting/objects/vpm-controller.integration.spec.ts lib/vpt/table/table.integration.spec.ts lib/game/player.integration.spec.ts",
		"bench": "node test/harness/bench.mjs",
		"bench:node": "tsx test/harness/bench-node.ts",
		"bench:walking-dead": "node test/harness/bench.mjs --vpx=walking_dead.vpx --profile",
		"bench:walking-dead:node": "tsx test/harness/bench-node.ts --vpx=walking_dead.vpx --ticks=300 --balls=1",
		"bench:walking-dead:browser": "node test/harness/bench.mjs --vpx=walking_dead.vpx --balls=1 --duration=5000 --warmup=1500 --profile",
		"bench:walking-dead:vitest": "vitest bench test/bench/walking-dead.bench.ts --run",
		"bench:walking-dead:breakdown": "tsx test/harness/bench-node.ts --vpx=/home/qinghao1/Downloads/walking_dead.vpx --ticks=5 --breakdown",
		"profile:walking-dead": "tsx test/harness/ranked-profile.ts --vpx=/home/qinghao1/Downloads/walking_dead.vpx",
		"bench:walking-dead:ranked": "tsx test/harness/ranked-profile.ts --vpx=/home/qinghao1/Downloads/walking_dead.vpx",
		"vpinball": "tsx bin/vpinball-runner.ts",
		"vpinball:setup": "bash scripts/setup-vpinball.sh",
		"vpinball:doctor": "tsx bin/vpinball-runner.ts --doctor",
		"vpinball:extract": "tsx bin/vpinball-runner.ts --extractvbs",
		"vpinball:audit": "tsx bin/vpinball-runner.ts --audit",
		"compare": "tsx test/harness/compare-side-by-side.ts",
		"verify:vpinball": "tsx test/harness/verify-vpinball-compat.ts",
		"verify:audit": "tsx test/harness/verify-vpinball-compat.ts --audit",
		"verify:discrepancies": "tsx test/harness/capture-discrepancies.ts"
	},
	"dependencies": {
		"dash-ast": "^2.0.0",
		"ebnf": "^1.9.1",
		"escodegen": "^1.14.3",
		"escope": "^4.0.0",
		"estraverse": "^5.3.0",
		"moo": "^0.5.3",
		"three": "^0.185.1",
		"three-mesh-bvh": "^0.9.14",
		"wpc-emu": "^0.36.7",
		"pako": "^2.1.0"
	},
	"optionalDependencies": {},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/chai": "^4.3.0",
		"@types/escodegen": "0.0.10",
		"@types/estraverse": "5.1.7",
		"@types/estree": "^1.0.0",
		"@types/mocha": "^10.0.0",
		"@types/moo": "^0.5.10",
		"@types/nearley": "^2.11.5",
		"@types/node": "^24.13.3",
		"@types/sinon": "^17.0.0",
		"@types/sinon-chai": "^3.2.0",
		"@types/three": "^0.185.4",
		"@vitest/coverage-v8": "^4.1.10",
		"chai": "^4.3.6",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"looks-same": "^7.2.3",
		"nock": "^13.5.0",
		"puppeteer-core": "^25.5.0",
		"sinon": "^17.0.0",
		"sinon-chai": "^3.7.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.11",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"bugs": {
		"url": "https://github.com/vpdb/vpx-js/issues"
	},
	"homepage": "https://github.com/vpdb/vpx-js#readme",
	"keywords": [
		"pinball",
		"visual pinball",
		"vp10",
		"vpx",
		"glb",
		"gltf"
	],
	"lint-staged": {
		"*.{js,mjs,cjs,ts,jsx,tsx,cts,mts,json,jsonc,css,html}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
