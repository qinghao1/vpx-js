{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!node_modules",
			"!!dist",
			"!!dist-esm",
			"!!coverage",
			"!external",
			"!test/fixtures",
			"!!demo-browser/dist",
			"!!demo-browser/node_modules",
			"!!demo-browser/public/wasm",
			"!**/bench*.spec.ts",
			"!**/*.vpx"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noPrecisionLoss": "off",
				"noConstructorReturn": "off",
				"noVoidTypeReturn": "off",
				"noConstantCondition": "off"
			},
			"suspicious": {
				"noImplicitAnyLet": "off",
				"noAssignInExpressions": "off",
				"noControlCharactersInRegex": "off",
				"noSelfCompare": "off",
				"noShadowRestrictedNames": "off",
				"useIterableCallbackReturn": "off"
			},
			"security": {
				"noGlobalEval": "off"
			},
			"performance": {
				"noDelete": "warn"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true,
			"bracketSameLine": false,
			"attributePosition": "auto"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"html": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"overrides": [
		{
			"includes": [".github/**"],
			"formatter": { "indentStyle": "space", "indentWidth": 2 }
		},
		{
			"includes": ["**/*.spec.ts", "**/*.integration.spec.ts", "test/**", "build/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noExportsInTest": "off"
					}
				}
			}
		}
	]
}
