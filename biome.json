{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!dist-esm",
			"!coverage",
			"!external",
			"!wasm/build",
			"!test/fixtures",
			"!lib/scripting/grammar/rules.ts",
			"!lib/render/threejs/vendor",
			"!demo-browser/dist",
			"!demo-browser/node_modules",
			"!lib/**/bench*.spec.ts",
			"!**/bench*.spec.ts",
			"!**/*.vpx"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.spec.ts", "**/*.integration.spec.ts", "test/**", "build/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noExportsInTest": "off"
					}
				}
			}
		},
		{
			"includes": ["lib/scripting/grammar/rules.ts", "lib/render/threejs/vendor/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		}
	]
}
