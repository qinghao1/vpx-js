{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["ES2024", "DOM"],
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"noImplicitOverride": false,
		"verbatimModuleSyntax": false,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"allowJs": true,
		"forceConsistentCasingInFileNames": true,
		"allowUnusedLabels": true,
		"useDefineForClassFields": false
	},
	"include": ["lib/**/*", "bin/**/*", "build/**/*"],
	"exclude": [".nyc_output", "node_modules", "dist", "coverage", "res", "test/fixtures", "demo-browser", "demo-static"]
}
