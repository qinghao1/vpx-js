From c7f4fb8ebd68635d401437cce70522cbfb6da8fb Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sat, 7 Nov 2026 12:00:00 -0500
Subject: [PATCH] vpx-js: vpinball-headless wasm target

Builds the headless player (ENABLE_HEADLESS) around the vpx-js embedding
bridge, given as -DVPX_HEADLESS_BRIDGE=<source path>, as an ES module with a
sidecar source map. Its data package keeps the
assets the player loads and drops those a headless player does without.
Local to vpx-js, not meant for upstream.
---
 make/CMakeLists_app.txt | 50 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/make/CMakeLists_app.txt b/make/CMakeLists_app.txt
index b6c89f3fa..d6d70a3de 100644
--- a/make/CMakeLists_app.txt
+++ b/make/CMakeLists_app.txt
@@ -1040,4 +1040,54 @@ elseif(PLATFORM STREQUAL "wasm")
       SUFFIX ".html"
    )
 
+   # Headless engine for vpx-js: the player built with ENABLE_HEADLESS around an
+   # embedding bridge (VPX_HEADLESS_BRIDGE, path to its source) instead of main.cpp.
+   if(VPX_HEADLESS_BRIDGE)
+      set(VPX_HEADLESS_SOURCES ${VPX_STANDALONE_SOURCES})
+      list(REMOVE_ITEM VPX_HEADLESS_SOURCES "src/core/main.cpp")
+      add_executable(vpinball-headless ${VPX_HEADLESS_SOURCES} "${VPX_HEADLESS_BRIDGE}")
+      add_dependencies(vpinball-headless vpx-shaders)
+      foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_DIRECTORIES LINK_LIBRARIES)
+         get_target_property(value vpinball ${property})
+         set_target_properties(vpinball-headless PROPERTIES ${property} "${value}")
+      endforeach()
+      target_compile_definitions(vpinball-headless PRIVATE ENABLE_HEADLESS)
+      # Sidecar source map: makes a crash in the shipped engine debuggable.
+      # Size-optimized build: -Oz comes after the inherited -O3 on the
+      # compile line, so it wins (last -O flag takes effect in clang).
+      target_compile_options(vpinball-headless PRIVATE -gsource-map -Oz)
+      target_link_options(vpinball-headless PRIVATE
+         -gsource-map
+         -Oz
+         --use-port=emdawnwebgpu
+         -sJSPI
+         # Table load/teardown block on engine threads: emscripten wraps them as
+         # promise-returning exports. Exports taking or returning pointers are
+         # wrapped too, so the wasm64 host passes and receives plain numbers.
+         -sJSPI_EXPORTS=VpxWasm_LoadTable,VpxWasm_DestroyTable
+         -sSIGNATURE_CONVERSIONS=VpxWasm_MountRom:_pp_,VpxWasm_LoadTable:_p_,VpxWasm_GetPartCatalogJson:p,VpxWasm_GetBuffer:p_,VpxWasm_GetDmdFrame:p,VpxWasm_GetFlasherImage:p_,VpxWasm_GetScriptError:p
+         -sALLOW_MEMORY_GROWTH=1
+         -sMAXIMUM_MEMORY=16GB
+         -sINITIAL_MEMORY=512MB
+         -sSTACK_SIZE=8MB
+         -sDEFAULT_PTHREAD_STACK_SIZE=2MB
+         -sPTHREAD_POOL_SIZE=32
+         -sMODULARIZE=1
+         -sEXPORT_ES6=1
+         -sEXPORT_NAME=createVpinballHeadless
+         -sEXPORTED_FUNCTIONS=_main,_malloc,_free
+         -sEXPORTED_RUNTIME_METHODS=UTF8ToString,HEAPU8,HEAPU32,HEAPF32
+         -Wl,--allow-multiple-definition
+         "--preload-file=${CMAKE_SOURCE_DIR}/src/assets@/assets"
+         "--preload-file=${CMAKE_SOURCE_DIR}/src/scripts@/scripts"
+         "--preload-file=${CMAKE_SOURCE_DIR}/plugins/nixie/layouts@/plugins/nixie/layouts"
+         "--preload-file=${CMAKE_SOURCE_DIR}/plugins/flexdmd/assets@/plugins/flexdmd/assets"
+         "--exclude-file=*.vpz"
+         "--exclude-file=*/src/assets/web"
+         "--exclude-file=*fabian-hrir.sofa"
+         "--exclude-file=*vbsdoc_outdated.html"
+         "--exclude-file=*LiberationSans-Regular.ttf"
+      )
+   endif()
+
 endif()
