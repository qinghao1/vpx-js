diff --git a/src/web/vpx_wasm_inline_pool.h b/src/web/vpx_wasm_inline_pool.h
new file mode 100644
index 00000000..2ee11c52
--- /dev/null
+++ b/src/web/vpx_wasm_inline_pool.h
@@ -0,0 +1,61 @@
+// Single-threaded stand-in for progschj::ThreadPool.
+//
+// Static hosts (GitHub Pages) cannot send COOP/COEP, so SharedArrayBuffer is
+// unavailable and thread construction aborts. Where the game fans independent
+// load/bake tasks out to a pool and then blocks until they finish, run them
+// inline instead: same calls, and the same completion guarantee as a pool
+// whose workers finish instantly. Only the small slice of the pool API those
+// sites use is provided (enqueue, enqueue_block, has_work_in_flight,
+// wait_until_empty, wait_until_nothing_in_flight). Tasks run on the caller's
+// thread; fire-and-forget tasks keep their own error handling, while the
+// future-returning form reports through the future the caller already checks.
+#ifdef VPX_WASM_SINGLE_THREADED
+#pragma once
+
+#include <cstddef>
+#include <future>
+#include <type_traits>
+#include <utility>
+
+class VpxInlinePool
+{
+public:
+   explicit VpxInlinePool(std::size_t = 1) { }
+
+   template <typename F, typename... Args>
+   void enqueue_block(F &&f, Args &&...args)
+   {
+      std::forward<F>(f)(std::forward<Args>(args)...);
+   }
+
+   // Future-returning form (physics quadtree): run inline and hand back an
+   // already-ready future. The caller treats a ready future as "already done",
+   // including its would_block fallback, so inline execution preserves its exact
+   // logic; a task exception surfaces through get(), where the caller ignores it.
+   template <typename F, typename... Args>
+   std::future<std::invoke_result_t<F, Args...>> enqueue(F &&f, Args &&...args)
+   {
+      using R = std::invoke_result_t<F, Args...>;
+      std::promise<R> done;
+      try
+      {
+         if constexpr (std::is_void_v<R>)
+         {
+            std::forward<F>(f)(std::forward<Args>(args)...);
+            done.set_value();
+         }
+         else
+            done.set_value(std::forward<F>(f)(std::forward<Args>(args)...));
+      }
+      catch (...)
+      {
+         done.set_exception(std::current_exception());
+      }
+      return done.get_future();
+   }
+
+   void wait_until_empty() { }
+   void wait_until_nothing_in_flight() { }
+   bool has_work_in_flight() { return false; }
+};
+#endif // VPX_WASM_SINGLE_THREADED
diff --git a/src/web/vpx_wasm_single_threaded_stubs.c b/src/web/vpx_wasm_single_threaded_stubs.c
new file mode 100644
index 00000000..c1e1f364
--- /dev/null
+++ b/src/web/vpx_wasm_single_threaded_stubs.c
@@ -0,0 +1,48 @@
+// Single-threaded static-hosting shims (VPX_WASM_SINGLE_THREADED only).
+//
+// Static hosts (GitHub Pages) cannot send COOP/COEP, so SharedArrayBuffer is
+// unavailable and the pthread build aborts at startup. With pthreads off,
+// emscripten omits a few blocking/threading symbols that prebuilt libs and
+// pinmame's time fence still reference. The shims below only take effect in
+// the single-threaded headless target.
+//
+// sem_timedwait: no other thread can post while this thread runs, so a
+// semaphore that is not immediately available can never become available
+// within this synchronous execution — time out at once instead of burning
+// CPU to the deadline.
+#ifdef VPX_WASM_SINGLE_THREADED
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <semaphore.h>
+#include <time.h>
+
+int sched_get_priority_min(int policy)
+{
+   (void)policy;
+   return 0;
+}
+
+int sched_get_priority_max(int policy)
+{
+   (void)policy;
+   return 0;
+}
+
+int pthread_setschedparam(pthread_t thread, int policy, const struct sched_param *param)
+{
+   (void)thread;
+   (void)policy;
+   (void)param;
+   return 0;
+}
+
+int sem_timedwait(sem_t *sem, const struct timespec *abs_timeout)
+{
+   (void)abs_timeout;
+   if (sem_trywait(sem) == 0)
+      return 0;
+   errno = ETIMEDOUT;
+   return -1;
+}
+#endif // VPX_WASM_SINGLE_THREADED
