+      add_link_options(-pthread -fwasm-exceptions)
+   else()
+      add_compile_options(-fwasm-exceptions)
+      add_link_options(-fwasm-exceptions)
+   endif()
 endif()
 
 if(BUILD_APP)
@@ -191,3 +197,14 @@ if(BUILD_APP)
 endif()
 
 include("${CMAKE_SOURCE_DIR}/make/CMakeLists_plugins.txt")
+
+# Single-threaded WASM (static hosting without COOP/COEP): the statically
+# linked plugins built into vpinball-headless need VPX_WASM_SINGLE_THREADED
+# too, or their background threads abort table load. WASM-only: on desktop
+# VPX_WASM_PTHREADS is undefined, so this must not leak there. Empty when
+# threads are on, so threaded builds (including the full web app) are untouched.
+if(PLATFORM STREQUAL "wasm")
+   foreach(_vpx_st_plugin AltSoundPlugin AlphaDMDPlugin B2SPlugin FlexDMDPlugin InspectorPlugin NixiePlugin PinMAMEPlugin PUPPlugin SerumPlugin UpscaleDMDPlugin VNIPlugin WMPPlugin)
+      target_compile_definitions(${_vpx_st_plugin} PRIVATE $<$<NOT:$<BOOL:${VPX_WASM_PTHREADS}>>:VPX_WASM_SINGLE_THREADED>)
+   endforeach()
+endif()
