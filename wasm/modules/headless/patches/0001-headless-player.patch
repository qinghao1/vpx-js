       const int pos = (*(int*)(m_state.data() + m_stateOffsets[static_cast<unsigned int>(uniformName)])) & 0xFF;
diff --git a/src/renderer/Window.cpp b/src/renderer/Window.cpp
index 95da8d0f9..214796bf9 100644
--- a/src/renderer/Window.cpp
+++ b/src/renderer/Window.cpp
@@ -369,6 +369,9 @@ void Window::RaiseAndFocus()
 }
 
 bool Window::IsFocused() const {
+#ifdef ENABLE_HEADLESS
+   return true; // Never shown, like VR windows: the host driving the player owns input
+#endif
    if (m_isVR)
       return true;
    return m_nwnd == SDL_GetKeyboardFocus();
