    }
    if (const char* const drv = SDL_GetCurrentVideoDriver()) {
       PLOGI << "SDL video driver: " << drv;
@@ -457,6 +461,11 @@ Player::Player(PinTable *const table, const PlayMode playMode, LoadProgress &loa
 
 void Player::LockRenderThread()
 {
+#ifdef VPX_HEADLESS_BRIDGE
+   // No frames are ever submitted headless; the frame mutex stays with the game thread.
+   return;
+#endif
+
 // Wait for any pending render frame to be finished, then acquire the frame mutex on the game thread.
 // This gives the game thread exclusive access to all the render data (mutual exclusion).
 #ifdef ENABLE_BGFX
@@ -469,6 +478,21 @@ void Player::LockRenderThread()
 #endif
 }
 
+#ifdef VPX_HEADLESS_BRIDGE
+void Player::StepHeadlessFrame(const double nowMs)
+{
+   m_time_msec = (uint32_t)nowMs;
+   UpdateGameLogic();
+   FinishFrame();
+   PrepareFrame();
+}
+#endif
+
 void Player::UnlockRenderThread()
 {
+#ifdef VPX_HEADLESS_BRIDGE
+   // Paired with the headless LockRenderThread no-op above: with no
+   // render thread the frame mutex stays with the game thread all session.
+   return;
+#endif
 #ifdef ENABLE_BGFX
@@ -2628,6 +2628,11 @@ void Player::SubmitFrame()
 void Player::SubmitFrame()
 {
+#ifdef VPX_HEADLESS_BRIDGE
+   // No render thread exists headless; the BGFX handoff below would
+   // release an unowned frame mutex.
+   return;
+#endif
    #ifdef ENABLE_BGFX
       // We must own m_renderer->m_renderDevice->m_frameMutex
       m_renderer->m_renderDevice->m_framePending = true;
       m_renderer->m_renderDevice->m_frameReadySem.release();
@@ -738,7 +757,7 @@ void Player::InitTableSession(const bool isInitial)
       for (const Texture *image : m_ptable->m_vimage)
          m_texLoadStats.nPixelsTotal += static_cast<uint64_t>(image->m_width) * image->m_height;
 
-#ifdef ENABLE_BGFX
+#if defined(ENABLE_BGFX) && !defined(VPX_HEADLESS_BRIDGE)
       std::unique_ptr<TextureCompressor> texCompressor;
       if (m_renderer->m_renderDevice->m_compressTextures && FileExists(m_ptable->m_filename))
       {
@@ -765,9 +784,9 @@ void Player::InitTableSession(const bool isInitial)
       vector<std::pair<Texture*, bool>> deferredUploads;
 #endif
       auto loadImage = [progressPos = m_loadProgress->GetProgress() + progressPhysicLength, maxTexDim,
-#ifdef ENABLE_BGFX
+#if defined(ENABLE_BGFX) && !defined(VPX_HEADLESS_BRIDGE)
                           texCompressor = texCompressor.get(),
-#else
+#elif !defined(ENABLE_BGFX)
                           &deferredUploads,
 #endif
                           &mutex, &nLoadInProgress, &nLoadPerformed, preloadCache, this, &failedPreloads](Texture *image, bool resizeOnLowMem)
@@ -806,8 +825,20 @@ void Player::InitTableSession(const bool isInitial)
                   const std::lock_guard<std::mutex> statsLock(m_texLoadStats.inFlightMutex);
                   m_texLoadStats.inFlight.emplace_back(image, false);
                }
+#ifdef VPX_HEADLESS_BRIDGE
+               // Headless: texture metadata (m_width/m_height) is valid pre-decode,
+               // so count the image done and skip CPU decode + GPU upload entirely.
+               nLoadPerformed++;
+               m_texLoadStats.nImagesDone.fetch_add(1, std::memory_order_relaxed);
+               m_texLoadStats.nPixelsDone.fetch_add(static_cast<uint64_t>(image->m_width) * image->m_height);
+               {
+                  const std::lock_guard<std::mutex> statsLock(m_texLoadStats.inFlightMutex);
+                  std::erase_if(m_texLoadStats.inFlight, [image](const std::pair<const Texture *, bool> &e) { return e.first == image; });
+               }
+               m_loadProgress->SetProgress("Loading Textures..."s, progressPos + progressTextureLength * static_cast<float>(nLoadPerformed) / (static_cast<float>(m_ptable->m_vimage.size()) - 1.f));
+#else
                std::shared_ptr<const BaseTexture> buffer;
-#ifdef ENABLE_BGFX
+#if defined(ENABLE_BGFX) && !defined(VPX_HEADLESS_BRIDGE)
                if (texCompressor)
                   buffer = texCompressor->Load(image, resizeOnLowMem,
                      [this, image, compressionStarted = false]() mutable
@@ -879,6 +910,7 @@ void Player::InitTableSession(const bool isInitial)
                   std::erase_if(m_texLoadStats.inFlight, [image](const std::pair<const Texture *, bool> &e) { return e.first == image; });
                }
                m_loadProgress->SetProgress("Loading Textures..."s, progressPos + progressTextureLength * static_cast<float>(nLoadPerformed) / (static_cast<float>(m_ptable->m_vimage.size()) - 1.f));
+#endif
             }
          }
          {
@@ -960,7 +992,7 @@ void Player::InitTableSession(const bool isInitial)
 
       LockRenderThread();
 
-#ifdef ENABLE_BGFX
