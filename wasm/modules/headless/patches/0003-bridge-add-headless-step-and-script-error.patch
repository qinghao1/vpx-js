From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:00:00 -0400
Subject: [PATCH 3/9] bridge: add headless step entry and script-error record

Player::StepHeadlessFrame sets the frame time and runs UpdateGameLogic/
FinishFrame/PrepareFrame (the render tail is compiled out by the 0004
guards). A Player method is required because FinishFrame/PrepareFrame
are private; UpdateGameLogic alone cannot drive a frame. The SDL-video
failure becomes a warning headless (no video device under Noop), table
texture decode/upload is skipped (the JS host owns textures; dimensions
are valid pre-decode), and OnScriptError records m_lastScriptError
(GetScriptErrorCount reuses the existing m_nScriptErrorNotification).

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/src/core/player.h b/src/core/player.h
index 33208ec..be41208 100644
--- a/src/core/player.h
+++ b/src/core/player.h
@@ -193,6 +193,12 @@ public:
    void GameLoop();
 
    void UpdateGameLogic();
+#ifdef VPX_HEADLESS_BRIDGE
+   // Single externally-driven frame step for the headless bridge (no render submit).
+   void StepHeadlessFrame(double nowMs);
+   // Last script error for headless diagnostics (empty when the script is healthy).
+   const std::string &GetLastScriptError() const { return m_lastScriptError; }
+#endif
 
    VideoSyncMode GetVideoSyncMode() const { return m_playMode == Player::PlayMode::CaptureAttract ? VideoSyncMode::VSM_NONE : m_videoSyncMode; }
    void SetVideoSyncMode(VideoSyncMode mode) { m_videoSyncMode = mode; }
@@ -393,6 +399,9 @@ public:
 
    CComObject<ScriptInterpreter>* m_scriptInterpreter = nullptr;
    unsigned int m_nScriptErrorNotification = 0;
+#ifdef VPX_HEADLESS_BRIDGE
+   std::string m_lastScriptError;
+#endif
    void OnScriptError(ScriptInterpreter::ErrorType type, int line, int column, const string &description, const vector<string> &stackDump);
 
    PinballPlugin::ResURIResolver m_resURIResolver;
diff --git a/src/core/player.cpp b/src/core/player.cpp
