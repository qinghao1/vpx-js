@@ -2600,7 +2635,7 @@ void Player::PrepareFrame()
       m_renderer->m_gpu_profiler.BeginFrame(m_renderer->m_renderDevice->GetCoreDevice());
    #endif
    
-   #if defined(ENABLE_BGFX)
