 namespace
 {
 
@@ -551,12 +551,54 @@ static void PullPinMameDmd()
    g_dmdHash = hash;
    g_dmdHashInit = true;
 }
 
+static unsigned g_dmdFlexHash = 0;
+static bool g_dmdFlexInit = false;
+
+// FlexDMD-driven tables (no PinMAME ROM) render score and mission state
+// through the script's FlexDMD stage. Mirror it into m_dmdFrame with the
+// same publish-on-change counter as the PinMAME lane. Runs only when no
+// frame is mirrored yet, so VPM tables keep their existing frames. The
+// first publish requires non-blank content: an idle instance only ever
+// serves its blank surface, which must not reveal the overlay.
+static void PullFlexDmd()
+{
+   if (!g_player)
+      return;
+   std::vector<uint8_t> px;
+   int w = 0, h = 0;
+   if (!FlexDMD_GetDmdPixels(px, w, h) || w <= 0 || h <= 0 || (int)px.size() < w * h)
+      return;
+   const int n = w * h;
+   const unsigned hash = DmdHash(px.data(), n);
+   if (g_dmdFlexInit && hash == g_dmdFlexHash)
+      return;
+   if (!g_dmdFlexInit)
+   {
+      bool blank = true;
+      for (int i = 0; i < n; i++)
+         if (px[i] != 0) { blank = false; break; }
+      if (blank)
+         return;
+   }
+   g_player->m_dmdSize = int2(w, h);
+   BaseTexture::Update(g_player->m_dmdFrame, (unsigned)w, (unsigned)h, BaseTexture::BW_FP32, nullptr);
+   float* const __restrict data = static_cast<float*>(g_player->m_dmdFrame->data());
+   for (int i = 0; i < n; i++)
+      data[i] = InvsRGBPercent((uint8_t)((int)px[i] * 100 / 255));
+   g_player->m_dmdFrameId++;
+   g_player->m_pluginAPI.OnDMDUpdated(nullptr, g_player->m_dmdFrame);
+   g_dmdFlexHash = hash;
+   g_dmdFlexInit = true;
+}
+
