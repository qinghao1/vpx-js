From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:00:00 -0400
Subject: [PATCH 4/9] bridge: run Noop renderer synchronously without canvas

RenderDevice: select the Noop backend instead of coercing it away, no
#canvas swapchain, and run the render thread function synchronously on
the game thread (no CanvasRenderHost/pthread); SubmitRenderFrame runs
inline on the game thread and bgfx shuts down on the game thread in the
destructor. ShaderState: guard every uniform accessor for offset -1
(Noop reports no uniforms; generalizes the existing optimized-out
precedent instead of asserting).

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/src/renderer/RenderDevice.cpp b/src/renderer/RenderDevice.cpp
index 7bdee85f8..ff539ff09 100644
--- a/src/renderer/RenderDevice.cpp
+++ b/src/renderer/RenderDevice.cpp
@@ -591,6 +591,12 @@ void RenderDevice::RenderThread(RenderDevice* rd, bgfx::Init init)
    // Unlock requesting thread and start render loop
    rd->m_rendererInitialized.release();
 
+#ifdef VPX_HEADLESS_BRIDGE
+   // No render loop headless; the game thread steps frames explicitly and shuts
+   // bgfx down in ~RenderDevice.
+   return;
+#endif
+
 #if defined(__STANDALONE__) && !defined(_WIN32) // bgfx/GLES lockup workaround for Android, not needed on Windows
    std::this_thread::sleep_for(std::chrono::milliseconds(500));
 #endif
@@ -1424,8 +1430,12 @@ RenderDevice::RenderDevice(
    if (!backendMatched && !gfxBackend.empty() && gfxBackend != "Default"s) {
       PLOGW << "Ignoring unknown or unsupported graphics backend '" << gfxBackend << "' (case sensitive), using platform default. Valid values: " << validBackends;
    }
+#ifdef VPX_HEADLESS_BRIDGE
+   init.type = bgfx::RendererType::Noop;
+#else
    if (init.type == bgfx::RendererType::Noop)
       init.type = bgfx::RendererType::Count;
+#endif
    if (g_pplayer->m_vrDevice == nullptr)
    {
       // Requested only: BGFX may fall back to another backend if the requested one cannot initialize. The
@@ -1462,7 +1472,11 @@ RenderDevice::RenderDevice(
    init.swapChain.ndt = wmInfo.info.vivante.display;
    init.swapChain.nwh = wmInfo.info.vivante.window;
    #elif BX_PLATFORM_EMSCRIPTEN
+#ifndef VPX_HEADLESS_BRIDGE
    init.swapChain.nwh = (void*)"#canvas";
+#else
+   init.swapChain.nwh = nullptr;
+#endif
    #endif // BX_PLATFORM_
    #ifdef DEBUG
    // Disable Direct3D12 debug layer as it crashes on some NVIDIA drivers
@@ -1474,21 +1488,21 @@ RenderDevice::RenderDevice(
 
    m_frameMutex.lock();
    m_renderDeviceAlive = true;
-#ifdef __EMSCRIPTEN__
+#if defined(VPX_HEADLESS_BRIDGE)
+   // Headless never presents: bgfx runs single-threaded on the game thread and
+   // frames are stepped explicitly, so run init synchronously with no render thread.
+   RenderThread(this, init);
+#elif defined(__EMSCRIPTEN__)
    // The render thread owns the canvas (transferred as an OffscreenCanvas) since it is the one creating the WebGPU surface
    CanvasRenderHost::Get().Run([this, init] { RenderThread(this, init); });
 #else
    m_renderThread = std::thread(&RenderThread, this, init);
-#endif
    while (!m_rendererInitialized.try_acquire())
    {
       g_pplayer->ProcessOSMessages(false);
-#ifdef __EMSCRIPTEN__
-      emscripten_sleep(1);
-#else
       Sleep(0);
-#endif
    }
+#endif
    m_useLowPrecision = bgfx::getRendererType() == bgfx::RendererType::OpenGLES;
 
 #elif defined(ENABLE_OPENGL)
@@ -1984,7 +1998,7 @@ RenderDevice::RenderDevice(
 
 RenderDevice::~RenderDevice()
 {
-   #if defined(ENABLE_BGFX)
+   #if defined(ENABLE_BGFX) && !defined(VPX_HEADLESS_BRIDGE)
       // Suspend rendering before deleting anything that could be used
       m_renderDeviceAlive = false;
       m_frameReadySem.release();
@@ -2047,6 +2061,11 @@ RenderDevice::~RenderDevice()
    if (bgfx::isValid(m_srgbMipmapProgram))
       bgfx::destroy(m_srgbMipmapProgram);
 
+#ifdef VPX_HEADLESS_BRIDGE
+   // No render thread headless (bgfx runs single-threaded on the game thread):
+   // shut it down once native resources are freed above.
+   bgfx::shutdown();
+#else
    // Shutdown BGFX once all native resources have been cleaned up
    m_rendererInitialized.release();
    while (!m_renderDeviceAlive)
@@ -2064,6 +2083,7 @@ RenderDevice::~RenderDevice()
    if (m_renderThread.joinable())
       m_renderThread.join();
 #endif
+#endif
 
 #elif defined(ENABLE_OPENGL)
    m_quadPNTDynMeshBuffer = nullptr;
@@ -2815,7 +2835,11 @@ void RenderDevice::SubmitRenderFrame()
    // A pending command dependency is only valid for the frame being recorded: drop it to avoid keeping a pointer on a recycled pass
    m_nextRenderCommandDependency = nullptr;
    #ifdef ENABLE_BGFX
-#ifdef __EMSCRIPTEN__
+#if defined(VPX_HEADLESS_BRIDGE)
+   // Single-threaded headless: the game thread is the bgfx API thread, so
+   // always execute recorded commands inline (and never consult CanvasRenderHost).
+   if (false)
+#elif defined(__EMSCRIPTEN__)
    if (!CanvasRenderHost::Get().IsCurrentThread())
 #else
    if (std::this_thread::get_id() != m_renderThread.get_id())
