From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Fri, 6 Nov 2026 00:00:00 -0400
Subject: [PATCH 19/19] bridge: single-threaded fallbacks for audio and ROM emulation

Static hosting without COOP/COEP cannot create threads, and two script-time
paths aborted there in std::thread's constructor:

- SoundPlayer dispatches all work to a progschj::ThreadPool worker, so the
  first script-driven PlaySound threw across the script boundary and
  terminated the runtime. Return nullptr from SoundPlayer::Create instead:
  both callers (sample playback and music) already treat nullptr as "no
  audio" and skip silently, matching the other single-threaded fallbacks
  (watchdog, texture/quadtree pools, B2S writer).
- libpinmame emulates the machine on its own game thread, so Controller::Run
  threw mid-startup, leaving PinMAME half-initialized. Skip the run with a
  warning instead; the playfield keeps stepping without ROM emulation.

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/plugins/pinmame/Controller.cpp b/plugins/pinmame/Controller.cpp
index 2c943662..99e27455 100644
--- a/plugins/pinmame/Controller.cpp
+++ b/plugins/pinmame/Controller.cpp
@@ -172,6 +172,15 @@ void Controller::Run(long hParentWnd, int nMinVersion)
    if (m_szRomName.empty())
       return;
 
+#ifdef VPX_WASM_SINGLE_THREADED
+   // No threads on static hosting (no COOP/COEP for SharedArrayBuffer):
+   // libpinmame emulates the machine on its own game thread, so skip the
+   // run instead of aborting in std::thread's constructor. The playfield
+   // keeps stepping; ROM emulation, DMD and ROM audio stay unavailable.
+   LOGW("ROM emulation unavailable without threads; skipping '"s + m_szRomName + '\'');
+   return;
+#endif
+
    PinmameSetCheat(m_cheat);
 
    // Disable sound if requested through game's settings object
diff --git a/src/audio/SoundPlayer.cpp b/src/audio/SoundPlayer.cpp
index 6268afec..c461c441 100644
--- a/src/audio/SoundPlayer.cpp
+++ b/src/audio/SoundPlayer.cpp
@@ -196,14 +196,29 @@ namespace VPX
 
 SoundPlayer* SoundPlayer::Create(const AudioPlayer* audioPlayer, Sound* sound)
 {
+#ifdef VPX_WASM_SINGLE_THREADED
+   // No threads on static hosting (no COOP/COEP for SharedArrayBuffer):
+   // SoundPlayer dispatches all work to a progschj::ThreadPool worker, so
+   // there is no audio device to play on. Callers already treat nullptr as
+   // "no audio" and skip playback, so return it instead of aborting in
+   // std::thread's constructor.
+   return nullptr;
+#else
    // Decode and resample the sound on the ancillary thread as this is fairly heavy
    return new SoundPlayer(audioPlayer, sound);
+#endif
 }
 
 SoundPlayer* SoundPlayer::Create(const AudioPlayer* audioPlayer, const std::filesystem::path& filename)
 {
+#ifdef VPX_WASM_SINGLE_THREADED
+   // No threads on static hosting (no COOP/COEP for SharedArrayBuffer):
+   // see Create above, music playback is likewise unavailable.
+   return nullptr;
+#else
    // Decode and resample the sound on the ancillary thread as this is fairly heavy
    return new SoundPlayer(audioPlayer, filename);
+#endif
 }
 
 SoundPlayer::SoundPlayer(const AudioPlayer* audioPlayer, const std::filesystem::path& filename)
