From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:00:00 -0400
Subject: [PATCH 5/17] bridge: add vpinball-headless CMake target

Self-contained vpinball-headless target (standalone sources minus
main.cpp plus the bridge). Kept decoupled from the app target on
purpose: removing this block removes the feature without touching the
existing web build. Same include dirs/definitions/link libs as the app
target, plus MODULARIZE/ES6 export, the VpxWasm_* export list, asset
preloads, and VPX_HEADLESS_BRIDGE.

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/make/CMakeLists_app.txt b/make/CMakeLists_app.txt
index 23f777cc7..9e815236d 100644
--- a/make/CMakeLists_app.txt
+++ b/make/CMakeLists_app.txt
@@ -1012,4 +1012,121 @@ elseif(PLATFORM STREQUAL "wasm")
       SUFFIX ".html"
    )
 
+   # Headless engine bridge for vpx-js (no renderer, no shell): the JS host
+   # drives VpxWasm_* (src/web/vpx_wasm_bridge.cpp) and reads state buffers.
+   set(VPX_HEADLESS_SOURCES ${VPX_STANDALONE_SOURCES})
+   list(REMOVE_ITEM VPX_HEADLESS_SOURCES "src/core/main.cpp")
+   list(APPEND VPX_HEADLESS_SOURCES "${CMAKE_SOURCE_DIR}/src/web/vpx_wasm_bridge.cpp")
+
+   add_executable(vpinball-headless
+      ${VPX_HEADLESS_SOURCES}
+   )
+
+   add_dependencies(vpinball-headless vpx-shaders)
+
+   target_include_directories(vpinball-headless PUBLIC
+      ${CMAKE_SOURCE_DIR}/third-party/include
+      ${CMAKE_SOURCE_DIR}
+      ${CMAKE_SOURCE_DIR}/third-party/include/libwinevbs/atl/include
+      ${CMAKE_SOURCE_DIR}/third-party/include/libwinevbs/wine/include
+      src
+      plugins
+   )
+
+   target_compile_definitions(vpinball-headless PRIVATE
+      __STANDALONE__
+
+      __LIBWINEVBS__
+      __WINESRC__
+      WINE_UNICODE_NATIVE
+
+      "__forceinline=__attribute__((always_inline)) inline"
+
+      ENABLE_BGFX
+      VPX_HEADLESS_BRIDGE
+      $<IF:$<CONFIG:Debug>,BX_CONFIG_DEBUG=1,BX_CONFIG_DEBUG=0>
+   )
+
+   target_compile_options(vpinball-headless PUBLIC
+      -Wno-inconsistent-missing-override
+      -Wno-missing-exception-spec
+      -fdenormal-fp-math=preserve-sign
+      -freciprocal-math
+      -fassociative-math
+      -fapprox-func
+      -fno-math-errno
+      -fno-trapping-math
+      -ffp-contract=off
+      -Wno-shorten-64-to-32
+      -msimd128
+   )
+
+   target_link_directories(vpinball-headless PUBLIC
+      "${BUILD_LIBS_DIR}"
+   )
+
+   target_link_libraries(vpinball-headless PUBLIC
+      bgfx
+      bimg_encode
+      bimg
+      bx
+      SDL3
+      SDL3_image
+      SDL3_ttf
+      freetype
+      harfbuzz
+      freeimage
+      winevbs
+      zip
+      spatialaudio
+      mysofa
+      pinmame
+      altsound
+      serum
+      pupdmd
+      vni
+      avcodec
+      avformat
+      avutil
+      swresample
+      swscale
+      z
+      m
+      AltSoundPlugin
+      AlphaDMDPlugin
+      B2SPlugin
+      FlexDMDPlugin
+      InspectorPlugin
+      NixiePlugin
+      PinMAMEPlugin
+      PUPPlugin
+      SerumPlugin
+      UpscaleDMDPlugin
+      VNIPlugin
+      WMPPlugin
+   )
+
+   target_link_options(vpinball-headless PUBLIC
+      --use-port=emdawnwebgpu
+      -sJSPI
+      -sALLOW_MEMORY_GROWTH=1
+      -sMAXIMUM_MEMORY=4GB
+      -sINITIAL_MEMORY=512MB
+      -sSTACK_SIZE=8MB
+      -sDEFAULT_PTHREAD_STACK_SIZE=2MB
+      -sPTHREAD_POOL_SIZE=32
+      -sMODULARIZE=1
+      -sEXPORT_ES6=1
+      -sEXPORT_NAME=createVpinballHeadless
+      -sEXPORTED_FUNCTIONS=_main,_malloc,_free,_VpxWasm_Init,_VpxWasm_MountRom,_VpxWasm_LoadTable,_VpxWasm_StepFrame,_VpxWasm_GetPartCatalogJson,_VpxWasm_GetBuffer,_VpxWasm_GetDmdFrame,_VpxWasm_PushKey,_VpxWasm_Nudge,_VpxWasm_DestroyTable,_VpxWasm_GetScriptErrorCount,_VpxWasm_GetScriptError
+      -sEXPORTED_RUNTIME_METHODS=UTF8ToString,HEAPU8,HEAPU32,HEAPF32
+      -Wl,--allow-multiple-definition
+      "--preload-file=${CMAKE_SOURCE_DIR}/src/assets@/assets"
+      "--preload-file=${CMAKE_SOURCE_DIR}/src/scripts@/scripts"
+      "--preload-file=${CMAKE_SOURCE_DIR}/plugins/nixie/layouts@/plugins/nixie/layouts"
+      "--preload-file=${CMAKE_SOURCE_DIR}/plugins/flexdmd/assets@/plugins/flexdmd/assets"
+      "--exclude-file=*.vpz"
+      "--exclude-file=*/src/assets/web"
+   )
+
 endif()
