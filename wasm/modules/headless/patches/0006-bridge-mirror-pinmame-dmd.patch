 namespace
 {
 
@@ -428,9 +434,49 @@ EMSCRIPTEN_KEEPALIVE const BridgeBufferView *VpxWasm_GetBuffer(int kind)
    return &g_view;
 }
 
+static unsigned DmdHash(const uint8_t* px, int n)
+{
+   unsigned h = 2166136261u;
+   for (int i = 0; i < n; i++) h = (h ^ px[i]) * 16777619u;
+   return h;
+}
+
+static unsigned g_dmdHash = 0;
+static bool g_dmdHashInit = false;
+
+// VPM tables never push DMDPixels from script; mirror the live PinMAME DMD
+// into m_dmdFrame so the WASM ABI serves it. Pulls lazily on read and
+// publishes only on change, so m_dmdFrameId stays a real change counter.
+static void PullPinMameDmd()
+{
+   if (!g_player)
+      return;
+   std::vector<uint8_t> px;
+   int w = 0, h = 0;
+   if (!PinMAME_GetDmdPixels(px, w, h) || w <= 0 || h <= 0 || (int)px.size() < w * h)
+      return;
+   const int n = w * h;
+   const unsigned hash = DmdHash(px.data(), n);
+   if (g_dmdHashInit && hash == g_dmdHash && g_player->m_dmdFrame
+       && g_player->m_dmdFrame->width() == (unsigned)w && g_player->m_dmdFrame->height() == (unsigned)h)
+      return;
+   g_player->m_dmdSize = int2(w, h);
+   BaseTexture::Update(g_player->m_dmdFrame, (unsigned)w, (unsigned)h, BaseTexture::BW_FP32, nullptr);
+   float* const __restrict data = static_cast<float*>(g_player->m_dmdFrame->data());
+   for (int i = 0; i < n; i++)
+      data[i] = InvsRGBPercent(px[i]);
+   g_player->m_dmdFrameId++;
+   g_player->m_pluginAPI.OnDMDUpdated(nullptr, g_player->m_dmdFrame);
+   g_dmdHash = hash;
+   g_dmdHashInit = true;
+}
+
