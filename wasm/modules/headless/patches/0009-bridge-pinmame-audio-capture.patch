+// Headless WASM bridge: forward PinMAME audio updates into the bridge PCM ring
+// (see VpxWasm_GetAudio). Deferred to the main thread by libpinmame (RunOnMainThread), so no locking.
+static void MSGPIAPI OnPinMAMEAudioUpdate(unsigned int /*msgId*/, void* /*context*/, void* msgData)
+{
+   const AudioUpdateMsg* const msg = static_cast<const AudioUpdateMsg*>(msgData);
+   if (msg == nullptr || msg->buffer == nullptr || msg->bufferSize == 0)
+      return;
+   if (msg->sampleFormat != CTLPI_AUDIO_FORMAT_SAMPLE_INT16)
+      return; // bridge ring is int16-only; PinMAME is configured for int16
+   const int channels = (msg->channelFormat == CTLPI_AUDIO_FORMAT_CHANNEL_STEREO) ? 2 : 1;
+   ::VpxWasm_PushAudio(msg->buffer, msg->bufferSize, channels, msg->sampleRate);
+}
