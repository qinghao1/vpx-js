+// ---- PinMAME ROM audio capture (int16 PCM ring) ----
+// Producer: OnPinMAMEAudioUpdate in the PinMAME plugin (libpinmame posts audio
+// updates on the main thread, same thread that runs StepFrame and this getter).
+// Consumer: VpxWasm_GetAudio below, which drains. Oldest samples are dropped on overflow.
+namespace {
+constexpr size_t kAudioCapSamples = 44100u * 2u * 4u; // 4 s of stereo
+struct AudioRing {
+   int sampleRate = 0;
+   int channels = 0;
+   std::vector<int16_t> buf;
+   size_t head = 0;
+   size_t count = 0;
+};
+AudioRing g_audio;
+int16_t g_audioOut[16384];
+}
+
+void VpxWasm_PushAudio(const uint8_t* pcm, unsigned byteCount, int channels, double sampleRate)
+{
+   if (pcm == nullptr || byteCount == 0 || (channels != 1 && channels != 2) || sampleRate <= 0.0)
+      return;
+   if (g_audio.buf.empty())
+      g_audio.buf.resize(kAudioCapSamples);
+   g_audio.sampleRate = (int)sampleRate;
+   g_audio.channels = channels;
+   const size_t n = byteCount / 2;
+   const int16_t* s = reinterpret_cast<const int16_t*>(pcm);
+   for (size_t i = 0; i < n; i++)
+   {
+      g_audio.buf[g_audio.head] = s[i];
+      g_audio.head = (g_audio.head + 1) % g_audio.buf.size();
+      if (g_audio.count < g_audio.buf.size())
+         g_audio.count++;
+   }
+}
+
+EMSCRIPTEN_KEEPALIVE const int32_t* VpxWasm_GetAudioInfo()
+{
+   static int32_t info[2];
+   info[0] = g_audio.sampleRate;
+   info[1] = g_audio.channels;
+   return info;
+}
+
+EMSCRIPTEN_KEEPALIVE const BridgeBufferView* VpxWasm_GetAudio()
+{
+   if (g_audio.buf.empty() || g_audio.count == 0)
+   {
+      g_view.ptr = 0;
+      g_view.count = 0;
+      g_view.stride = g_audio.channels;
+      return &g_view;
+   }
+   const size_t cap = sizeof(g_audioOut) / sizeof(g_audioOut[0]);
+   const size_t n = (g_audio.count < cap) ? g_audio.count : cap;
+   size_t idx = (g_audio.head + g_audio.buf.size() - g_audio.count) % g_audio.buf.size();
+   for (size_t i = 0; i < n; i++)
+   {
+      g_audioOut[i] = g_audio.buf[idx];
+      idx = (idx + 1) % g_audio.buf.size();
+   }
+   g_audio.count -= n;
+   g_view.ptr = (n == 0) ? 0 : (int)(intptr_t)g_audioOut;
+   g_view.count = (int)n;
+   g_view.stride = g_audio.channels;
+   return &g_view;
+}
+
 static unsigned DmdHash(const uint8_t* px, int n)
