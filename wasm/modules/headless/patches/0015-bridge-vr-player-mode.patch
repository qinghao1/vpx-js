From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Thu, 5 Nov 2026 00:00:00 -0500
Subject: [PATCH 15/17] bridge: play in VR player mode

The vpx-js host shows the table in its VR room and cabinet, so play in
VR mode: default the standalone RenderingModeOverride to VR, letting
scripts pick their own room, and apply the 10.8+ part-group VR
visibility mask as Renderer::RenderItem does. Rebuild with
wasm/build-headless.sh.

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/src/web/vpx_wasm_bridge.cpp b/src/web/vpx_wasm_bridge.cpp
index 59e54437..fcbbfa9d 100644
--- a/src/web/vpx_wasm_bridge.cpp
+++ b/src/web/vpx_wasm_bridge.cpp
@@ -29,6 +29,7 @@
 #include "parts/flipper.h"
 #include "parts/gate.h"
 #include "parts/hittarget.h"
+#include "parts/PartGroup.h"
 #include "parts/kicker.h"
 #include "parts/light.h"
 #include "parts/pintable.h"
@@ -179,6 +180,9 @@ void RebuildCatalog()
 
 float PartVisible(IEditable *const part)
 {
+   // Player mode visibility mask of 10.8+ part groups, as Renderer::RenderItem applies it.
+   if (part->GetPartGroup() && (part->GetPartGroup()->GetPlayerModeVisibilityMask() & PartGroupData::PMVM_VIRTUAL_REALITY) == 0)
+      return 0.f;
    // All part data blocks derive from BaseProperty, which owns m_visible.
    switch (part->GetItemType())
    {
@@ -345,6 +349,8 @@ EMSCRIPTEN_KEEPALIVE int VpxWasm_Init()
 {
    if (g_app)
       return 0;
+   // Play in VR mode: scripts read RenderingMode = 2 and show their own room and cabinet.
+   Settings::SetStandalone_RenderingModeOverride_Default(2);
    g_app = new VPApp();
    g_app->InitInstance(true);
    return 0;
