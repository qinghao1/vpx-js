From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Fri, 6 Nov 2026 00:00:00 -0400
Subject: [PATCH 17/17] bridge: ABI version, escaped part catalog, full session reset

- VpxWasm_GetAbiVersion: an integer the host checks once at load, so a
  stale or newer engine artifact fails loudly instead of degrading per
  frame (missing exports, mismatched strides).
- The part catalog JSON-escapes names and type names: one quote,
  backslash or control character in a table-authored name no longer
  breaks the whole catalog.
- ResetBridgeFrameState also clears the FlexDMD publish latch and hash
  and the captured audio format, so a table loaded into a reused module
  publishes its first FlexDMD frame and relearns its own audio rate.
  (Every bridge export already carries EMSCRIPTEN_KEEPALIVE, so no
  -sEXPORTED_FUNCTIONS change is needed.)

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/src/web/vpx_wasm_bridge.cpp b/src/web/vpx_wasm_bridge.cpp
--- a/src/web/vpx_wasm_bridge.cpp
+++ b/src/web/vpx_wasm_bridge.cpp
@@ -157,6 +157,31 @@ const char *ItemTypeName(const ItemTypeEnum type)
    }
 }
 
+// Part names are table-authored: escape quotes, backslashes and control
+// characters so one odd name cannot break the whole catalog.
+void AppendJsonString(std::string &json, const string &value)
+{
+   json += '"';
+   for (const char ch : value)
+   {
+      const unsigned char c = (unsigned char)ch;
+      if (c == '"' || c == '\\')
+      {
+         json += '\\';
+         json += ch;
+      }
+      else if (c < 0x20)
+      {
+         char esc[7];
+         snprintf(esc, sizeof(esc), "\\u%04x", c);
+         json += esc;
+      }
+      else
+         json += ch;
+   }
+   json += '"';
+}
+
 void RebuildCatalog()
 {
    std::string json = "[";
@@ -165,14 +190,13 @@ void RebuildCatalog()
    {
       if (i > 0)
          json += ',';
-      const string &name = parts[i]->GetName();
       json += "{\"idx\":";
       json += std::to_string(i);
-      json += ",\"name\":\"";
-      json += name;
-      json += "\",\"type\":\"";
-      json += ItemTypeName(parts[i]->GetItemType());
-      json += "\"}";
+      json += ",\"name\":";
+      AppendJsonString(json, parts[i]->GetName());
+      json += ",\"type\":";
+      AppendJsonString(json, ItemTypeName(parts[i]->GetItemType()));
+      json += '}';
    }
    json += ']';
    g_catalog = std::move(json);
@@ -345,6 +369,14 @@ void FillBuffers()
 extern "C"
 {
 
+// Bump on any change to the exported functions, descriptor structs or buffer
+// row layouts; vpx-js refuses an engine whose version differs
+// (HEADLESS_ABI_VERSION in lib/wasm/vpinball-wasm.ts).
+EMSCRIPTEN_KEEPALIVE int VpxWasm_GetAbiVersion()
+{
+   return 1;
+}
+
 EMSCRIPTEN_KEEPALIVE int VpxWasm_Init()
 {
    if (g_app)
@@ -689,12 +721,18 @@ EMSCRIPTEN_KEEPALIVE void VpxWasm_SetAudioLevel(float volume, int muted)
 }
 
 // Drop any previous session's audio/DMD residue: the ring keeps its
-// allocation, the DMD hash restarts so the first frame always publishes.
+// allocation, the audio format is relearned from the next table's first push,
+// and both DMD hashes restart so the first frame always publishes.
 static void ResetBridgeFrameState()
 {
    g_audio.count = 0;
    g_audio.head = 0;
+   g_audio.sampleRate = 0;
+   g_audio.channels = 0;
+   g_dmdHash = 0;
    g_dmdHashInit = false;
+   g_dmdFlexHash = 0;
+   g_dmdFlexInit = false;
 }
 
 EMSCRIPTEN_KEEPALIVE void VpxWasm_DestroyTable()
