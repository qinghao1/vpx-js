From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:00:00 -0400
Subject: [PATCH 1/9] bridge: add vpx_wasm_bridge.cpp headless engine entry

New file only; no upstream modifications. Exposes the VpxWasm_* C ABI
for the vpx-js host (see vpx-js lib/wasm/): Init, MountRom, LoadTable,
StepFrame, GetPartCatalogJson, GetBuffer (balls/movers/lights/prims/
flashers as flat float rows), GetDmdFrame, PushKey, Nudge, DestroyTable,
GetScriptErrorCount/GetScriptError. State is published per frame; the
host steps the engine from requestAnimationFrame and applies rows to
its own scene.

Target: vpinball/vpinball@64a480a96d1b972711fbb8eea014654c779b1e23

diff --git a/src/web/vpx_wasm_bridge.cpp b/src/web/vpx_wasm_bridge.cpp
new file mode 100644
index 000000000..1bcc3a527
--- /dev/null
+++ b/src/web/vpx_wasm_bridge.cpp
@@ -0,0 +1,514 @@
+// Visual Pinball - Headless engine bridge for vpx-js.
+// vpinball-headless target only (VPX_HEADLESS_BRIDGE). Lets a JS host drive the
+// real Player/PhysicsEngine without a renderer: tables load from memory, frames
+// step on demand, and per-frame state is published as flat float buffers the
+// host applies to its own scene (see vpx-js lib/wasm/).
+//
+// The bridge mirrors CallbackSteppedGameLoop but never touches the frame
+// handshake or the submit path: UpdateGameLogic() -> FinishFrame() ->
+// PrepareFrame() with the render tail compiled out (VPX_HEADLESS_BRIDGE guards
+// in player.cpp / RenderDevice.cpp). The render thread still starts (Noop
+// backend) so the texture manager and upload paths keep working; it idles on
+// its semaphore because no frame is ever submitted.
+
+#include "core/stdafx.h"
+
+#include <chrono>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "core/VPApp.h"
+#include "core/extern.h"
+#include "core/player.h"
+#include "parts/ball.h"
+#include "parts/bumper.h"
+#include "parts/flasher.h"
+#include "parts/flipper.h"
+#include "parts/gate.h"
+#include "parts/hittarget.h"
+#include "parts/kicker.h"
+#include "parts/light.h"
+#include "parts/pintable.h"
+#include "parts/plunger.h"
+#include "parts/primitive.h"
+#include "parts/spinner.h"
+#include "parts/trigger.h"
+#include "physics/PhysicsEngine.h"
+#include "physics/cabinet/NudgeHandler.h"
+#include "ui/VPXFileFeedback.h"
+#include "physics/hitball.h"
+#include "physics/hitflipper.h"
+#include "physics/hitplunger.h"
+#include "physics/collideex.h"
+#include "renderer/Texture.h"
+
+#include <emscripten.h>
+
+// Keep in sync with vpx-js lib/wasm/vpinball-wasm.ts.
+enum class BufferKind : int
+{
+   Balls = 0,
+   Movers = 1,
+   Lights = 2,
+   Prims = 3,
+   Flashers = 4
+};
+
+enum class MoverType : int
+{
+   Flipper = 0,
+   Plunger = 1,
+   Spinner = 2,
+   Gate = 3,
+   Bumper = 4,
+   HitTarget = 5,
+   Trigger = 6
+};
+
+namespace
+{
+
+constexpr const char *TABLE_PATH = "/bridge/table.vpx";
+constexpr const char *ROM_DIR = "/bridge/pinmame/roms";
+
+CComObject<PinTable> *g_table;
+Player *g_player;
+std::string g_catalog;
+std::vector<float> g_buf[5];
+int g_bufStride[5];
+int g_bufCount[5];
+
+struct BridgeBufferView
+{
+   int ptr;
+   int count;
+   int stride;
+};
+BridgeBufferView g_view;
+
+struct BridgeDmdFrame
+{
+   int ptr;
+   int width;
+   int height;
+   int format;
+   int frameId;
+};
+BridgeDmdFrame g_dmd;
+
+uint64_t NowNs()
+{
+   using namespace std::chrono;
+   return (uint64_t)duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+void PushRow(std::vector<float> &buf, std::initializer_list<float> values)
+{
+   buf.insert(buf.end(), values.begin(), values.end());
+}
+
+int ToRGB(const COLORREF c)
+{
+   return (int)(((c & 0x0000FF) << 16) | (c & 0x00FF00) | ((c & 0xFF0000) >> 16));
+}
+
+const char *ItemTypeName(const ItemTypeEnum type)
+{
+   switch (type)
+   {
+   case eItemFlipper: return "flipper";
+   case eItemPlunger: return "plunger";
+   case eItemSpinner: return "spinner";
+   case eItemGate: return "gate";
+   case eItemBumper: return "bumper";
+   case eItemHitTarget: return "hittarget";
+   case eItemTrigger: return "trigger";
+   case eItemLight: return "light";
+   case eItemPrimitive: return "primitive";
+   case eItemFlasher: return "flasher";
+   case eItemKicker: return "kicker";
+   case eItemRamp: return "ramp";
+   case eItemRubber: return "rubber";
+   case eItemSurface: return "surface";
+   case eItemTimer: return "timer";
+   case eItemTextbox: return "textbox";
+   case eItemDispReel: return "dispreel";
+   case eItemLightSeq: return "lightseq";
+   case eItemDecal: return "decal";
+   case eItemCollection: return "collection";
+   default: return "unknown";
+   }
+}
+
+void RebuildCatalog()
+{
+   std::string json = "[";
+   const vector<IEditable *> &parts = g_table->GetParts();
+   for (size_t i = 0; i < parts.size(); ++i)
+   {
+      if (i > 0)
+         json += ',';
+      const string &name = parts[i]->GetName();
+      json += "{\"idx\":";
+      json += std::to_string(i);
+      json += ",\"name\":\"";
+      json += name;
+      json += "\",\"type\":\"";
+      json += ItemTypeName(parts[i]->GetItemType());
+      json += "\"}";
+   }
+   json += ']';
+   g_catalog = std::move(json);
+}
+
+float PartVisible(IEditable *const part)
+{
+   // All part data blocks derive from BaseProperty, which owns m_visible.
+   switch (part->GetItemType())
+   {
+   case eItemFlipper: return static_cast<Flipper *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemPlunger: return static_cast<Plunger *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemSpinner: return static_cast<Spinner *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemGate: return static_cast<Gate *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemBumper: return static_cast<Bumper *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemHitTarget: return static_cast<HitTarget *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemTrigger: return static_cast<Trigger *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemLight: return static_cast<Light *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemPrimitive: return static_cast<Primitive *>(part)->m_d.m_visible ? 1.f : 0.f;
+   case eItemFlasher: return static_cast<Flasher *>(part)->m_d.m_isVisible ? 1.f : 0.f;
+   default: return 1.f;
+   }
+}
+
+void FillBuffers()
+{
+   for (int k = 0; k < 5; k++)
+   {
+      g_buf[k].clear();
+      g_bufCount[k] = 0;
+   }
+   g_bufStride[0] = 16;
+   g_bufStride[1] = 8;
+   g_bufStride[2] = 8;
+   g_bufStride[3] = 22;
+   g_bufStride[4] = 8;
+   if (!g_player)
+      return;
+   const vector<IEditable *> &parts = g_table->GetParts();
+   // Balls (dynamic; ids from the Ball parts backing each HitBall).
+   for (HitBall *const hb : g_player->m_physics->GetBalls())
+   {
+      if (!hb || !hb->m_pBall)
+         continue;
+      const float *o = &hb->m_orientation.m_d[0][0];
+      PushRow(g_buf[0],
+         { (float)hb->m_pBall->GetID(), hb->m_d.m_pos.x, hb->m_d.m_pos.y, hb->m_d.m_pos.z, hb->m_d.m_radius, o[0], o[1], o[2], o[3],
+            o[4], o[5], o[6], o[7], o[8], (float)ToRGB(hb->m_pBall->m_d.m_color), 1.f });
+      g_bufCount[0]++;
+   }
+   // Parts: movers, lights, primitives, flashers.
+   for (size_t i = 0; i < parts.size(); ++i)
+   {
+      IEditable *const part = parts[i];
+      const float idx = (float)i;
+      const float vis = PartVisible(part);
+      switch (part->GetItemType())
+      {
+      case eItemFlipper:
+      {
+         auto *const flipper = static_cast<Flipper *>(part);
+         const HitFlipper *const hf = flipper->GetHitFlipper();
+         if (!hf)
+            break;
+         PushRow(g_buf[1], { idx, (float)MoverType::Flipper, hf->m_flipperMover.m_angleCur, 0.f, 0.f, 0.f, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemPlunger:
+      {
+         auto *const plunger = static_cast<Plunger *>(part);
+         const HitPlunger *const hp = plunger->GetHitPlunger();
+         if (!hp)
+            break;
+         const PlungerMoverObject &mover = hp->m_plungerMover;
+         PushRow(g_buf[1],
+            { idx, (float)MoverType::Plunger, mover.m_pos, mover.m_frameStart, mover.m_frameEnd, 0.f, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemSpinner:
+      {
+         auto *const spinner = static_cast<Spinner *>(part);
+         const HitSpinner *const hs = spinner->GetHitSpinner();
+         if (!hs)
+            break;
+         PushRow(g_buf[1], { idx, (float)MoverType::Spinner, hs->m_spinnerMover.m_angle, 0.f, 0.f, 0.f, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemGate:
+      {
+         auto *const gate = static_cast<Gate *>(part);
+         const HitGate *const hg = gate->GetHitGate();
+         if (!hg)
+            break;
+         PushRow(g_buf[1], { idx, (float)MoverType::Gate, hg->m_gateMover.m_angle, 0.f, 0.f, 0.f, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemBumper:
+      {
+         auto *const bumper = static_cast<Bumper *>(part);
+         const BumperHitCircle *const bc = bumper->GetBumperHitCircle();
+         const float ring = bc ? bc->m_bumperanim_ringAnimOffset : 0.f;
+         const BumperData &bd = bumper->m_d;
+         const int bits = (bd.m_capVisible ? 1 : 0) | (bd.m_baseVisible ? 2 : 0) | (bd.m_ringVisible ? 4 : 0)
+            | (bd.m_skirtVisible ? 8 : 0);
+         PushRow(g_buf[1],
+            { idx, (float)MoverType::Bumper, ring, bumper->GetSkirtRotX(), bumper->GetSkirtRotY(), (float)bits, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemHitTarget:
+      {
+         auto *const target = static_cast<HitTarget *>(part);
+         PushRow(g_buf[1],
+            { idx, (float)MoverType::HitTarget, target->GetMoveAnimationOffset(), target->m_d.m_isDropped ? 1.f : 0.f, 0.f, 0.f, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemTrigger:
+      {
+         auto *const trigger = static_cast<Trigger *>(part);
+         PushRow(g_buf[1], { idx, (float)MoverType::Trigger, trigger->GetAnimHeightOffset(), 0.f, 0.f, 0.f, vis, 0.f });
+         g_bufCount[1]++;
+         break;
+      }
+      case eItemLight:
+      {
+         auto *const light = static_cast<Light *>(part);
+         PushRow(g_buf[2],
+            { idx, light->m_currentIntensity, light->m_d.m_intensity, light->m_d.m_intensity_scale, light->m_inPlayState ? 1.f : 0.f,
+               (float)ToRGB(light->m_d.m_color), (float)ToRGB(light->m_d.m_color2), vis });
+         g_bufCount[2]++;
+         break;
+      }
+      case eItemPrimitive:
+      {
+         auto *const prim = static_cast<Primitive *>(part);
+         const PrimitiveData &pd = prim->m_d;
+         PushRow(g_buf[3],
+            { idx, pd.m_vPosition.x, pd.m_vPosition.y, pd.m_vPosition.z, pd.m_vSize.x, pd.m_vSize.y, pd.m_vSize.z,
+               pd.m_aRotAndTra[0], pd.m_aRotAndTra[1], pd.m_aRotAndTra[2], pd.m_aRotAndTra[3], pd.m_aRotAndTra[4],
+               pd.m_aRotAndTra[5], pd.m_aRotAndTra[6], pd.m_aRotAndTra[7], pd.m_aRotAndTra[8], vis, (float)ToRGB(pd.m_color),
+               pd.m_alpha, (float)pd.m_disableLightingTop, (float)pd.m_disableLightingBelow, (float)prim->GetCurrentFrame() });
+         g_bufCount[3]++;
+         break;
+      }
+      case eItemFlasher:
+      {
+         auto *const flasher = static_cast<Flasher *>(part);
+         const FlasherData &fd = flasher->m_d;
+         PushRow(g_buf[4],
+            { idx, vis, (float)fd.m_alpha, (float)ToRGB(fd.m_color), (float)fd.m_intensity_scale,
+               (float)fd.m_modulate_vs_add, fd.m_addBlend ? 1.f : 0.f, flasher->m_inPlayState ? 1.f : 0.f });
+         g_bufCount[4]++;
+         break;
+      }
+      default: break;
+      }
+   }
+}
+
+} // namespace
+
+extern "C"
+{
+
+EMSCRIPTEN_KEEPALIVE int VpxWasm_Init()
+{
+   if (g_app)
+      return 0;
+   g_app = new VPApp();
+   g_app->InitInstance(true);
+   return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int VpxWasm_MountRom(const char *fileName, const uint8_t *zip, int len)
+{
+   if (!fileName || !zip || len <= 0)
+      return -1;
+   std::error_code ec;
+   std::filesystem::create_directories(ROM_DIR, ec);
+   if (ec)
+      return -2;
+   const std::string path = std::string(ROM_DIR) + "/" + fileName;
+   FILE *const f = fopen(path.c_str(), "wb");
+   if (!f)
+      return -3;
+   const size_t written = fwrite(zip, 1, (size_t)len, f);
+   fclose(f);
+   return written == (size_t)len ? 0 : -4;
+}
+
+static void ResetBridgeFrameState();
+
+EMSCRIPTEN_KEEPALIVE int VpxWasm_LoadTable(const uint8_t *vpx, int len)
+{
+   if (!g_app || !vpx || len <= 0)
+      return -1;
+   {
+      std::error_code ec;
+      std::filesystem::create_directories(std::filesystem::path(TABLE_PATH).parent_path(), ec);
+      if (ec)
+         return -2;
+      FILE *const f = fopen(TABLE_PATH, "wb");
+      if (!f)
+         return -2;
+      const size_t written = fwrite(vpx, 1, (size_t)len, f);
+      fclose(f);
+      if (written != (size_t)len)
+         return -3;
+   }
+   if (g_player)
+   {
+      delete g_player;
+      g_player = nullptr;
+   }
+   if (g_table)
+   {
+      g_table->Release();
+      g_table = nullptr;
+   }
+   ResetBridgeFrameState();
+   CComObject<PinTable>::CreateInstance(&g_table);
+   g_table->AddRef();
+   VPXFileFeedback feedback;
+   const HRESULT hr = g_table->LoadGameFromFilename(TABLE_PATH, feedback);
+   if (FAILED(hr))
+   {
+      g_table->Release();
+      g_table = nullptr;
+      return -4;
+   }
+   LoadProgress loadProgress;
+   g_player = new Player(g_table, Player::PlayMode::Play, loadProgress);
+   RebuildCatalog();
+   FillBuffers();
+   return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void VpxWasm_StepFrame(double nowMs)
+{
+   if (!g_player)
+      return;
+   g_player->StepHeadlessFrame(nowMs);
+   FillBuffers();
+}
+
+EMSCRIPTEN_KEEPALIVE const char *VpxWasm_GetPartCatalogJson()
+{
+   return g_catalog.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE int VpxWasm_GetScriptErrorCount()
+{
+   if (!g_player)
+      return -1;
+   return (int)g_player->m_nScriptErrorNotification;
+}
+
+EMSCRIPTEN_KEEPALIVE const char *VpxWasm_GetScriptError()
+{
+   if (!g_player)
+      return nullptr;
+   const std::string &err = g_player->GetLastScriptError();
+   return err.empty() ? nullptr : err.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE const BridgeBufferView *VpxWasm_GetBuffer(int kind)
+{
+   if (kind < 0 || kind > 4)
+      return nullptr;
+   g_view.ptr = g_buf[kind].empty() ? 0 : (int)(intptr_t)g_buf[kind].data();
+   g_view.count = g_bufCount[kind];
+   g_view.stride = g_bufStride[kind];
+   return &g_view;
+}
+
+EMSCRIPTEN_KEEPALIVE const BridgeDmdFrame *VpxWasm_GetDmdFrame()
+{
+   if (!g_player || !g_player->m_dmdFrame)
+      return nullptr;
+   const std::shared_ptr<BaseTexture> &frame = g_player->m_dmdFrame;
+   int format = 0;
+   const void *pixels = nullptr;
+   switch (frame->m_format)
+   {
+   case BaseTexture::BW_FP32: format = 1; pixels = frame->data(); break;
+   case BaseTexture::SRGB: format = 2; pixels = frame->data(); break;
+   case BaseTexture::SRGBA: format = 2; pixels = frame->GetAlias(BaseTexture::SRGB)->data(); break;
+   default: return nullptr;
+   }
+   if (!pixels)
+      return nullptr;
+   g_dmd.ptr = (int)(intptr_t)pixels;
+   g_dmd.width = (int)frame->width();
+   g_dmd.height = (int)frame->height();
+   g_dmd.format = format;
+   g_dmd.frameId = (int)g_player->m_dmdFrameId.load();
+   return &g_dmd;
+}
+
+EMSCRIPTEN_KEEPALIVE void VpxWasm_PushKey(int sdlScancode, int isPressed)
+{
+   if (!g_player)
+      return;
+   g_player->m_pininput.PushButtonEvent(
+      g_player->m_pininput.GetKeyboardDeviceId(), (uint16_t)sdlScancode, NowNs(), isPressed != 0);
+}
+
+EMSCRIPTEN_KEEPALIVE void VpxWasm_Nudge(float angleDeg, float force)
+{
+   if (!g_player)
+      return;
+   g_player->m_pininput.m_nudgeHandler->ApplyKeyboardImpulse(angleDeg, force);
+}
+
+// Drop any previous session's audio/DMD residue: the ring keeps its
+// allocation, the DMD hash restarts so the first frame always publishes.
+static void ResetBridgeFrameState()
+{
+   g_audio.count = 0;
+   g_audio.head = 0;
+   g_dmdHashInit = false;
+}
+
+EMSCRIPTEN_KEEPALIVE void VpxWasm_DestroyTable()
+{
+   if (g_player)
+   {
+      delete g_player;
+      g_player = nullptr;
+   }
+   if (g_table)
+   {
+      g_table->Release();
+      g_table = nullptr;
+   }
+   ResetBridgeFrameState();
+   g_catalog.clear();
+   for (int k = 0; k < 5; k++)
+   {
+      g_buf[k].clear();
+      g_bufCount[k] = 0;
+   }
+}
+
+} // extern "C"
+
+int main()
+{
+   return 0;
+}
