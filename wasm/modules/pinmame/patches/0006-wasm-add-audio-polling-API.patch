From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:00:00 -0400
Subject: [PATCH] wasm: add audio polling API

Poll decoded PCM from JS instead of pushing it through C->JS callbacks
(DMD polling precedent): snapshot every mixer chunk into a small INT16
mirror inside osd_update_audio_stream BEFORE/REGARDLESS of the
cb_OnAudioUpdated early-return, keep the mixer pump primed when no
callback is configured, and expose PinmameGetAudioFrame /
PinmameGetAudioChannels / PinmameGetAudioSeq. Produce runs on the game
thread and drain on the main thread, so the mirror control words are
atomic and the seqlock drops torn reads. Zero config change: INT16
44100 default keeps working.

Upstream-PR-Draft: libpinmame: add polling audio-frame API (PinmameGetAudioFrame/Channels/Seq)
Target: vpinball/pinmame@master
Body:
Why: Callback-less hosts (e.g. Emscripten builds) cannot read decoded PCM, while lamps/sols/GIs already offer PinmameGetChanged* polling getters. Worse, both no-callback paths return 0, yet the mixer takes osd_update_audio_stream's return as the next frame's count — so it stalls at zero.
How:
- Mirror every produced chunk into a small seqlock-guarded INT16 buffer in osd_update_audio_stream, regardless of callback branches.
- Return the nominal sample count from both no-callback paths to keep the mixer pump primed.
- Export PinmameGetAudioFrame/Channels/Seq; frame read drains, so an idle second pull yields 0.
Tested: Polled frames from a callback-less host; verified continuous, non-torn PCM with an idle second pull yielding 0.

---
 src/libpinmame/libpinmame.cpp | 82 ++++++++++++++++++++++++++++++++++++++++-
 src/libpinmame/libpinmame.h   |  3 ++
 2 files changed, 84 insertions(+), 1 deletions(-)

diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index c002e44..1d345fa 100644
@@ -5,6 +5,7 @@
 #include "../../ext/libsamplerate/samplerate.h"
 
 #include <atomic>
+#include <cstddef>
 #include <shared_mutex>
 #include <thread>
 #include <vector>
@@ -76,6 +77,26 @@
 static PinmameAudioInfo _audioInfo;
 static float _audioData[PINMAME_ACCUMULATOR_SAMPLES * 2];
 
+// Poll mirror for the JS-pulls-frames path: every chunk produced by the
+// mixer is snapshotted here as interleaved INT16, then drained by
+// PinmameGetAudioFrame. Overwrite-on-produce (not a ring): bursts
+// collapse into one slot. Produce runs on the game thread, drain on the
+// main thread, so the control words are atomic; the seqlock drops torn
+// chunks (a click, never corruption).
+static INT16 _audioMirror[PINMAME_ACCUMULATOR_SAMPLES * 2];
+static std::atomic<int> _audioMirrorFrames{0};
+static std::atomic<int> _audioMirrorChannels{0};
+// Odd while publishing: the poller drops reads bracketed by a change.
+static std::atomic<int> _audioMirrorSeq{0};
+
+// TS writeConfig writes sample rate i32 at +4, VPM dir at +8; the rest
+// stays zeroed (INT16 format, no callbacks).
+static_assert(offsetof(PinmameConfig, audioFormat) == 0, "audioFormat must stay at +0");
+static_assert(offsetof(PinmameConfig, sampleRate) == 4, "sampleRate must stay at +4");
+static_assert(offsetof(PinmameConfig, vpmPath) == 8, "vpmPath must stay at +8");
+static_assert(offsetof(PinmameConfig, cb_OnAudioAvailable) == 532, "cb_OnAudioAvailable must stay at +532");
+static_assert(offsetof(PinmameConfig, cb_OnAudioUpdated) == 536, "cb_OnAudioUpdated must stay at +536");
+
 static int _nvramInit = 0;
 static uint8_t _nvram[CORE_MAXNVRAM];
 static PinmameNVRAMState _nvramState[CORE_MAXNVRAM];
@@ -625,7 +646,17 @@
    }
    else
    {
-      return 0;
+      // No callback: fill the nominal descriptor and return the nominal
+      // count so the mixer keeps producing for polling.
+      memset(&_audioInfo, 0, sizeof(PinmameAudioInfo));
+      _audioInfo.format = _p_Config->audioFormat;
+      _audioInfo.channels = stereo ? 2 : 1;
+      _audioInfo.sampleRate = Machine->sample_rate;
+      _audioInfo.framesPerSecond = Machine->drv->frames_per_second;
+      _audioInfo.samplesPerFrame = (int)(Machine->sample_rate / Machine->drv->frames_per_second);
+      _audioInfo.bufferSize = PINMAME_ACCUMULATOR_SAMPLES * 2;
+
+      return _audioInfo.samplesPerFrame;
    }
 }
 
@@ -635,6 +666,24 @@
 
 extern "C" int osd_update_audio_stream(INT16* p_buffer)
 {
+   // Snapshot every produced chunk before/regardless of the branches below,
+   // so PinmameGetAudioFrame works with zero config.
+   if (p_buffer) {
+      const int samplesThisFrame = mixer_samples_this_frame();
+      if (samplesThisFrame > 0) {
+         const int channels = msgLocals.registered
+            ? (msgLocals.nAudioChannels > 0 ? (int)msgLocals.nAudioChannels : 1)
+            : (_audioInfo.channels > 0 ? _audioInfo.channels : 1);
+         const int capFrames = (int)(sizeof(_audioMirror) / sizeof(_audioMirror[0]) / (unsigned)channels);
+         const int frames = samplesThisFrame < capFrames ? samplesThisFrame : capFrames;
+         _audioMirrorSeq.fetch_add(1, std::memory_order_release);
+         memcpy(_audioMirror, p_buffer, (size_t)frames * (size_t)channels * sizeof(INT16));
+         _audioMirrorFrames.store(frames, std::memory_order_release);
+         _audioMirrorChannels.store(channels, std::memory_order_release);
+         _audioMirrorSeq.fetch_add(1, std::memory_order_release);
+      }
+   }
+
    if (msgLocals.registered)
    {
       // Sound disabled (sample rate 0): nothing to stream. Sending empty 0 Hz updates makes the host
@@ -675,12 +724,15 @@

       return (*(_p_Config->cb_OnAudioUpdated))((void*)_audioData, samplesThisFrame, _p_userData);
    }
    else
    {
-      return 0;
+      // No callback: the mixer adopts this return as next frame's count,
+      // so returning 0 here stalls it at zero samples forever. Return the
+      // nominal count to keep the pump primed.
+      return static_cast<int>(Machine->sample_rate / Machine->drv->frames_per_second);
    }
 }

 /******************************************************
  * osd_stop_audio_stream
  ******************************************************/
@@ -692,6 +745,37 @@
 }
 
 /******************************************************
+ * PinmameGetAudioChannels / PinmameGetAudioFrame
+ ******************************************************/
+
+PINMAMEAPI int PinmameGetAudioChannels()
+{
+	return _audioMirrorChannels.load(std::memory_order_acquire);
+}
+
+PINMAMEAPI int PinmameGetAudioSeq()
+{
+	return _audioMirrorSeq.load(std::memory_order_acquire);
+}
+
+PINMAMEAPI int PinmameGetAudioFrame(void* p_data, int maxFrames)
+{
+	// 0 = nothing to drain yet (or bad args): normal, not an error.
+	if (!p_data || maxFrames <= 0)
+		return 0;
+	const int framesAvail = _audioMirrorFrames.load(std::memory_order_acquire);
+	const int channels = _audioMirrorChannels.load(std::memory_order_acquire);
+	if (framesAvail <= 0 || channels <= 0)
+		return 0;
+	const int frames = framesAvail < maxFrames ? framesAvail : maxFrames;
+	memcpy(p_data, _audioMirror, (size_t)frames * (size_t)channels * sizeof(INT16));
+	// Drain-on-read: a second pull before the next chunk yields 0 instead
+	// of replaying the same audio twice.
+	_audioMirrorFrames.store(0, std::memory_order_release);
+	return frames;
+}
+
+/******************************************************
  * osd_sound_enable
  ******************************************************/
 
diff --git a/src/libpinmame/libpinmame.h b/src/libpinmame/libpinmame.h
index 2bfbddd..af31fca 100644
@@ -536,6 +536,9 @@
 PINMAMEAPI void PinmameSetHandleMechanics(const int handleMechanics);
 PINMAMEAPI PINMAME_DMD_MODE PinmameGetDmdMode();
 PINMAMEAPI void PinmameSetDmdMode(const PINMAME_DMD_MODE dmdMode);
+PINMAMEAPI int PinmameGetAudioChannels();
+PINMAMEAPI int PinmameGetAudioSeq();
+PINMAMEAPI int PinmameGetAudioFrame(void* p_data, int maxFrames);
 PINMAMEAPI PINMAME_STATUS PinmameRun(const char* const p_name);
 PINMAMEAPI int PinmameIsRunning();
 PINMAMEAPI PINMAME_STATUS PinmamePause(const int pause);
