From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:00:00 -0400
Subject: [PATCH] wasm: add DMD polling API

Add DMD polling API (FindDmdDisplay, GetDmdWidth/Height/Depth/Frame
and generic DisplayCount/Info/Frame) used by PinMameEmulator.

Anchored after PinmameGetRawMemoryRegionLength; API surface unchanged.

Upstream-PR-Draft: libpinmame: add DMD/display polling getters
Target: vpinball/pinmame@master
Body:
Why: Display frames are reachable only through the MsgPluginAPI push path, while lamps, solenoids, and GIs already offer PinmameGetChanged* polling getters. Hosts that cannot use that push path (e.g. Emscripten builds) have no way to read displays.
How:
- Add PinmameGetDmdWidth/Height/Depth/Frame, resolving the first DMD display.
- Add PinmameGetDisplayCount/Info/Frame for indexed polling of every display.
- Serve VIDEO-type displays as 4-bit grayscale through the same path (RGB888 and packed 565 packings).
- Share one copy helper for both frame getters; polling getters take the shared state lock like the other getters.
Tested: Ran several DMD and alphanumeric games, polling frames each tick; reported sizes match layouts and frame bytes match the push path.

---
 src/libpinmame/libpinmame.cpp | 108 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 src/libpinmame/libpinmame.h   | 7 ++++
 2 files changed, 115 insertions(+)
diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index 1307750..bd5bb63 100644
--- a/src/libpinmame/libpinmame.cpp
+++ b/src/libpinmame/libpinmame.cpp
@@ -2265,6 +2345,114 @@ PINMAMEAPI size_t PinmameGetRawMemoryRegionLength(const int region)
 	return IsEmulationRunning() ? memory_region_length(region) : 0;
 }
 
+/******************************************************
+ * PinmameGetDmdWidth / Height / Depth / Frame
+ ******************************************************/
+
+static PinmameDisplay* FindDmdDisplay()
+{
+	for (auto* d : _displays) if (d && (d->layout.type & PINMAME_DISPLAY_TYPE_SEGMASK) == PINMAME_DISPLAY_TYPE_DMD) return d;
+	for (auto* d : _displays) if (d && (d->layout.type & PINMAME_DISPLAY_TYPE_SEGMASK) == PINMAME_DISPLAY_TYPE_VIDEO) return d;
+	return nullptr;
+}
+
+PINMAMEAPI int PinmameGetDmdWidth()
+{
+	const std::shared_lock lock(_stateMutex);
+	auto* d = FindDmdDisplay();
+	return d ? d->layout.width : 0;
+}
+
+PINMAMEAPI int PinmameGetDmdHeight()
+{
+	const std::shared_lock lock(_stateMutex);
+	auto* d = FindDmdDisplay();
+	return d ? d->layout.height : 0;
+}
+
+PINMAMEAPI int PinmameGetDmdDepth()
+{
+	const std::shared_lock lock(_stateMutex);
+	auto* d = FindDmdDisplay();
+	if (!d) return 0;
+	if ((d->layout.type & PINMAME_DISPLAY_TYPE_SEGMASK) == PINMAME_DISPLAY_TYPE_VIDEO) return 4;
+	return d->layout.depth;
+}
+
+/* Output frame size in bytes: VIDEO frames are served as 4-bit grayscale (see CopyDisplayFrame), everything else raw */
+static int DisplayFrameSize(const PinmameDisplay* d)
+{
+	if ((d->layout.type & PINMAME_DISPLAY_TYPE_SEGMASK) == PINMAME_DISPLAY_TYPE_VIDEO)
+		return d->layout.width * d->layout.height;
+	return d->size;
+}
+
+/* Copy one frame into p_data, which must hold at least DisplayFrameSize(d) bytes: raw bytes, except VIDEO which is
+   folded to 4-bit grayscale — 24-bit RGB888 via REC601 luma, 16-bit 5.6.5 expanded per channel first */
+static void CopyDisplayFrame(const PinmameDisplay* d, void* p_data)
+{
+	if ((d->layout.type & PINMAME_DISPLAY_TYPE_SEGMASK) == PINMAME_DISPLAY_TYPE_VIDEO) {
+		uint8_t* dst = (uint8_t*)p_data;
+		const int n = d->layout.width * d->layout.height;
+		if (d->layout.depth == 16) {
+			const UINT16* src = (const UINT16*)d->pData;
+			for (int i = 0; i < n; i++) {
+				const int r = (src[i] >> 11) & 0x1f, g = (src[i] >> 5) & 0x3f, b = src[i] & 0x1f;
+				const int v = ((((r << 3) | (r >> 2)) * 77 + ((g << 2) | (g >> 4)) * 150 + ((b << 3) | (b >> 2)) * 29)) >> 8;
+				dst[i] = (uint8_t)((v * 15 + 127) / 255);
+			}
+		}
+		else {
+			const uint8_t* src = (const uint8_t*)d->pData;
+			for (int i = 0; i < n; i++) {
+				const int v = (src[i*3] * 77 + src[i*3+1] * 150 + src[i*3+2] * 29) >> 8;
+				dst[i] = (uint8_t)((v * 15 + 127) / 255);
+			}
+		}
+		return;
+	}
+	memcpy(p_data, d->pData, d->size);
+}
+
+PINMAMEAPI int PinmameGetDmdFrame(void* p_data)
+{
+	const std::shared_lock lock(_stateMutex);
+	auto* d = FindDmdDisplay();
+	if (!d || !d->pData || !p_data) return 0;
+	/* No size parameter (bridge compat): the caller provides GetDmdWidth() * GetDmdHeight() bytes, which covers
+	   both the raw DMD (size == width * height) and the grayscale VIDEO path */
+	CopyDisplayFrame(d, p_data);
+	return DisplayFrameSize(d);
+}
+
+PINMAMEAPI int PinmameGetDisplayCount()
+{
+	const std::shared_lock lock(_stateMutex);
+	return _displays.size();
+}
+
+/* Returns the output frame size in bytes (0 when absent); p_layout always describes the raw stored packing */
+PINMAMEAPI int PinmameGetDisplayInfo(int idx, PinmameDisplayLayout* p_layout)
+{
+	const std::shared_lock lock(_stateMutex);
+	if (idx < 0 || idx >= (int)_displays.size() || !p_layout) return 0;
+	PinmameDisplay* d = _displays[idx];
+	if (!d) return 0;
+	*p_layout = d->layout;
+	return DisplayFrameSize(d);
+}
+
+PINMAMEAPI int PinmameGetDisplayFrame(int idx, void* p_data, int size)
+{
+	const std::shared_lock lock(_stateMutex);
+	if (idx < 0 || idx >= (int)_displays.size() || !p_data) return 0;
+	PinmameDisplay* d = _displays[idx];
+	if (!d || !d->pData) return 0;
+	if (size < DisplayFrameSize(d)) return 0;
+	CopyDisplayFrame(d, p_data);
+	return DisplayFrameSize(d);
+}
+
 /******************************************************
  * PinmameSetUserData
  ******************************************************/
diff --git a/src/libpinmame/libpinmame.h b/src/libpinmame/libpinmame.h
index 74cddfb..1bed56e 100644
--- a/src/libpinmame/libpinmame.h
+++ b/src/libpinmame/libpinmame.h
@@ -579,6 +582,13 @@ PINMAMEAPI int PinmameReadMainCPUMemory(uint32_t address, uint8_t* const p_buffe
 PINMAMEAPI int PinmameWriteMainCPUMemory(uint32_t address, const uint8_t* const p_buffer, int size);
 PINMAMEAPI const uint8_t* PinmameGetRawMemoryRegion(const int region);
 PINMAMEAPI size_t PinmameGetRawMemoryRegionLength(const int region);
+PINMAMEAPI int PinmameGetDmdWidth();
+PINMAMEAPI int PinmameGetDmdHeight();
+PINMAMEAPI int PinmameGetDmdDepth();
+PINMAMEAPI int PinmameGetDmdFrame(void* p_data);
+PINMAMEAPI int PinmameGetDisplayCount();
+PINMAMEAPI int PinmameGetDisplayInfo(int idx, PinmameDisplayLayout* p_layout);
+PINMAMEAPI int PinmameGetDisplayFrame(int idx, void* p_data, int size);
 PINMAMEAPI void PinmameSetUserData(void* const p_userData);
 
 // If defined, libPinMame will implement the core controller messages for display, input & output state queries
--
