From e6b11b59fb5acf706c8da31226088a89fd3d8e76 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 9 Aug 2026 01:43:38 -0400
Subject: [PATCH] wasm: make update_display polling-safe

Run libpinmame_update_display without a callback and make it safe:
report pending updates on config presence instead of callback
presence, add bounds and null checks, copy pData unconditionally
and guard callback invocations.

Upstream-PR-Draft: libpinmame: harden libpinmame_update_display against null/empty display state
Target: vpinball/pinmame@master
Body:
Why: libpinmame_update_display indexes _displays with no validation: a null layout with empty _displays reads index -1 out of bounds, and dereferencing a null _p_Config or display entry crashes. Hosts that poll displays instead of registering a callback (e.g. Emscripten builds) need needs_update_display to check config presence, not callback presence.
How:
- needs_update_display returns on _p_Config presence instead of callback presence.
- Return early when index is outside the _displays range.
- Return early on a null display entry.
- Guard _p_Config and cb_OnDisplayUpdated before each callback; valid-state path unchanged.
Tested: Guards trigger only on previously crashing inputs; valid-state behavior unchanged.

---
 src/libpinmame/libpinmame.cpp | 41 ++++++++++++++++++-----------------
 1 file changed, 19 insertions(+), 22 deletions(-)

diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index ef03d37..6d4702c 100644
--- a/src/libpinmame/libpinmame.cpp
+++ b/src/libpinmame/libpinmame.cpp
@@ -735,40 +820,37 @@
  * libpinmame_update_display
  ******************************************************/
 
-extern "C" int libpinmame_needs_update_display() { return _p_Config->cb_OnDisplayUpdated != nullptr; }
+extern "C" int libpinmame_needs_update_display() { return _p_Config != nullptr; }
 
 extern "C" void libpinmame_update_display(const struct core_dispLayout* layout, void* p_data)
 {
-	// If layout is null, update the custom DMD generated from alphanumeric segment displays
 	int index = layout == nullptr ? ((int)_displays.size() - 1) : layout->index;
+	if (index < 0 || index >= (int)_displays.size()) return;
 	PinmameDisplay* pDisplay = _displays[index];
+	if (!pDisplay) return;
 	if ((pDisplay->layout.type & CORE_SEGMASK) == CORE_VIDEO) {
 		const bool changed = UpdatePinmameDisplayBitmap(pDisplay, (mame_bitmap*)p_data);
-		if (changed)
+		if (changed) pDisplay->frameId++;
+		if (_p_Config && _p_Config->cb_OnDisplayUpdated)
+			(*(_p_Config->cb_OnDisplayUpdated))(index, changed ? pDisplay->pData : nullptr, &pDisplay->layout, _p_userData);
+	} else if ((pDisplay->layout.type & CORE_SEGMASK) == CORE_DMD) {
+		if (memcmp(pDisplay->pData, p_data, pDisplay->size)) {
+			memcpy(pDisplay->pData, p_data, pDisplay->size);
 			pDisplay->frameId++;
-		if (_p_Config->cb_OnDisplayUpdated)
-			(*(_p_Config->cb_OnDisplayUpdated))(index, changed ? pDisplay->pData : nullptr, &pDisplay->layout, _p_userData);
-	}
-	else if (_p_Config->cb_OnDisplayUpdated) {
-		if ((pDisplay->layout.type & CORE_SEGMASK) == CORE_DMD) {
-			if (memcmp(pDisplay->pData, p_data, pDisplay->size)) {
-				memcpy(pDisplay->pData, p_data, pDisplay->size);
-				pDisplay->frameId++;
+			if (_p_Config && _p_Config->cb_OnDisplayUpdated)
 				(*(_p_Config->cb_OnDisplayUpdated))(index, pDisplay->pData, &pDisplay->layout, _p_userData);
-			}
-			else
-				(*(_p_Config->cb_OnDisplayUpdated))(index, nullptr, &pDisplay->layout, _p_userData);
+		} else if (_p_Config && _p_Config->cb_OnDisplayUpdated) {
+			(*(_p_Config->cb_OnDisplayUpdated))(index, nullptr, &pDisplay->layout, _p_userData);
 		}
-		else
-		{
-			if (memcmp(pDisplay->pData, p_data, pDisplay->size)) {
-				memcpy(pDisplay->pData, p_data, pDisplay->size);
-				pDisplay->frameId++;
+	} else {
+		if (memcmp(pDisplay->pData, p_data, pDisplay->size)) {
+			memcpy(pDisplay->pData, p_data, pDisplay->size);
+			pDisplay->frameId++;
+			if (_p_Config && _p_Config->cb_OnDisplayUpdated)
 				(*(_p_Config->cb_OnDisplayUpdated))(index, pDisplay->pData, &pDisplay->layout, _p_userData);
-			}
-			else
-				(*(_p_Config->cb_OnDisplayUpdated))(index, nullptr, &pDisplay->layout, _p_userData);
+		} else if (_p_Config && _p_Config->cb_OnDisplayUpdated) {
+			(*(_p_Config->cb_OnDisplayUpdated))(index, nullptr, &pDisplay->layout, _p_userData);
 		}
 	}
 }

