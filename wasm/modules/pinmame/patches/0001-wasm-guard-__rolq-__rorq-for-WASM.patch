From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:00:00 -0400
Subject: [PATCH] wasm: guard __rolq/__rorq for WASM

__rolq/__rorq intrinsics are not available in WASM/Emscripten.
Guard with __EMSCRIPTEN__ so the portable C fallback is used.

Targets src/bitops.h.

Upstream-PR-Draft: wasm: guard x86 __rolq/__rorq intrinsics in bitops.h
Target: vpinball/pinmame@master
Body: Emscripten Clang defines __clang__ but provides no x86 __rolq/__rorq intrinsics, so rotl_64/rotr_64 in src/bitops.h fail to compile for wasm32 targets. This extends the existing architecture exclusion using the Emscripten-provided __EMSCRIPTEN__ macro, so those targets use the portable C fallback that ARM builds already use. Tested in a downstream Emscripten build: the WASM target compiles with the guard and fails without it, while native x86/ARM paths are unchanged.

---
 src/bitops.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/bitops.h b/src/bitops.h
index ededc03..10e4c74 100644
--- a/src/bitops.h
+++ b/src/bitops.h
@@ -40,7 +40,7 @@ BITOPS_INLINE unsigned long long rotl_64(const unsigned long long x, const unsig
 {
 #ifdef _MSC_VER
     return _rotl64(x, count);
-#elif !defined(__arm__) && !defined(__aarch64__) && (defined(__INTEL_COMPILER) || (defined(__GNUC__) && (__GNUC__ > 3)) || defined(__clang__))
+#elif !defined(__arm__) && !defined(__aarch64__) && !defined(__EMSCRIPTEN__) && (defined(__INTEL_COMPILER) || (defined(__GNUC__) && (__GNUC__ > 3)) || defined(__clang__))
     return __rolq(x, count);
 #else
     return (x<<count) | (x>>( (unsigned int)(-(int)count)&63 )); // -count&63 instead of 64-count to handle count==0
@@ -62,7 +62,7 @@ BITOPS_INLINE unsigned long long rotr_64(const unsigned long long x, const unsig
 {
 #ifdef _MSC_VER
     return _rotr64(x, count);
-#elif !defined(__arm__) && !defined(__aarch64__) && (defined(__INTEL_COMPILER) || (defined(__GNUC__) && (__GNUC__ > 3)) || defined(__clang__))
+#elif !defined(__arm__) && !defined(__aarch64__) && !defined(__EMSCRIPTEN__) && (defined(__INTEL_COMPILER) || (defined(__GNUC__) && (__GNUC__ > 3)) || defined(__clang__))
     return __rorq(x, count);
 #else
     return (x>>count) | (x<<( (unsigned int)(-(int)count)&63 )); // -count&63 instead of 64-count to handle count==0
-- 
