From f6ea44209a2bc9c95cbeb1b12d196024f6dfbf61 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 9 Aug 2026 01:43:38 -0400
Subject: [PATCH] wasm: fix ComposePath missing slash

ComposePath concatenated path and file without a separator.
Add '/' when needed, otherwise ROM audit fails (e.g. /pinmame + roms).

Upstream-PR-Draft: libpinmame: insert missing separator in ComposePath
Target: vpinball/pinmame@master
Body: Why: ComposePath() concatenates the PinmameSetConfig path and the subfolder name with no separator, so any caller passing a path without a trailing slash gets broken paths (e.g. `/pinmame` + `roms` becomes `/pinmameroms`). In-tree callers all pass a trailing slash, which is why this never surfaced natively. How: in src/libpinmame/libpinmame.cpp, ComposePath() appends '/' when the path is non-empty and ends in neither '/' nor '\'. Tested: separator-less inputs now join correctly; inputs already ending in a separator are unchanged.

---
 src/libpinmame/libpinmame.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index bb50bca..ef03d37 100644
--- a/src/libpinmame/libpinmame.cpp
+++ b/src/libpinmame/libpinmame.cpp
@@ -181,7 +181,9 @@ static char* ComposePath(const char* const path, const char* const file)
 	char* const newPath = (char*)malloc(pathLength + fileLength + 4);
 
 	strcpy(newPath, path);
-	strcpy(newPath + pathLength, file);
+	if (pathLength > 0 && path[pathLength - 1] != '/' && path[pathLength - 1] != '\\')
+		strcat(newPath, "/");
+	strcat(newPath, file);
 	return newPath;
 }
 
