From 1b05333db58dd65b0d22372f603bf060d5391f2e Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 9 Aug 2026 01:43:38 -0400
Subject: [PATCH 6/8] wasm: disable AT91 JIT for WASM

AT91 JIT needs executable memory, not available in WASM.
Disable JIT and use interpreter for WASM builds.

---
 src/libpinmame/libpinmame.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index 6d4702c..ea171c4 100644
--- a/src/libpinmame/libpinmame.cpp
+++ b/src/libpinmame/libpinmame.cpp
@@ -797,7 +797,11 @@ PINMAMEAPI void PinmameSetConfig(const PinmameConfig* const p_config)
 	options.skip_disclaimer = 1;
 	// Enable the AT91 JIT (SAM games via sam.c, DE/Whitestar AT91 sound boards via desound.c;
 	// 1 = default address range). Only effective in builds that compile a JIT in
+	#ifdef PINMAME_WASM
+	options.at91jit = 0;
+	#else
 	options.at91jit = 1;
+	#endif
 
 	setPath(FILETYPE_ROM, ComposePath(_p_Config->vpmPath, "roms"));
 	setPath(FILETYPE_NVRAM, ComposePath(_p_Config->vpmPath, "nvram"));
-- 
