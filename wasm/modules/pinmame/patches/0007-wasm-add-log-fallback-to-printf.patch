From 35d2cc9de24e3e34a4ef830a13b6a95b67e82eb4 Mon Sep 17 00:00:00 2001
From: Chu Qinghao <6337103+qinghao1@users.noreply.github.com>
Date: Sun, 9 Aug 2026 01:43:38 -0400
Subject: [PATCH 7/8] wasm: add log fallback to printf

Add fallback to printf/vfprintf when no log callback is set.
Helps debugging ROM load failures in WASM.

---
 src/libpinmame/libpinmame.cpp | 14 ++++++--------
 1 file changed, 6 insertions(+), 8 deletions(-)

diff --git a/src/libpinmame/libpinmame.cpp b/src/libpinmame/libpinmame.cpp
index ea171c4..629bc2c 100644
--- a/src/libpinmame/libpinmame.cpp
+++ b/src/libpinmame/libpinmame.cpp
@@ -630,12 +630,11 @@ extern "C" void OnSolenoid(const int solenoid, const int state)
 
 extern "C" void libpinmame_log_info(const char* format, ...)
 {
-	if (!_p_Config->cb_OnLogMessage)
-		return;
-
 	va_list args;
 	va_start(args, format);
-	(*(_p_Config->cb_OnLogMessage))(PINMAME_LOG_LEVEL_INFO, format, args, _p_userData);
+	if (_p_Config && _p_Config->cb_OnLogMessage)
+		(*(_p_Config->cb_OnLogMessage))(PINMAME_LOG_LEVEL_INFO, format, args, _p_userData);
+	else { vprintf(format, args); printf("\n"); }
 	va_end(args);
 }
 
@@ -645,12 +644,11 @@ extern "C" void libpinmame_log_info(const char* format, ...)
 
 extern "C" void libpinmame_log_error(const char* format, ...)
 {
-	if (!_p_Config->cb_OnLogMessage)
-		return;
-
 	va_list args;
 	va_start(args, format);
-	(*(_p_Config->cb_OnLogMessage))(PINMAME_LOG_LEVEL_ERROR, format, args, _p_userData);
+	if (_p_Config && _p_Config->cb_OnLogMessage)
+		(*(_p_Config->cb_OnLogMessage))(PINMAME_LOG_LEVEL_ERROR, format, args, _p_userData);
+	else { vfprintf(stderr, format, args); fprintf(stderr, "\n"); }
 	va_end(args);
 }
 
